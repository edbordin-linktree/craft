#!/usr/bin/env bash
set -euo pipefail

STATE="${FAKE_CMUX_STATE:?FAKE_CMUX_STATE required}"
mkdir -p "$(dirname "$STATE")"

if [[ ! -f "$STATE" ]]; then
    cat > "$STATE" <<'JSON'
{
  "next_workspace": 2,
  "next_pane": 2,
  "next_surface": 2,
  "focused": "",
  "sent": [],
  "windows": [
    {
      "ref": "window:1",
      "workspaces": [
        {
          "ref": "workspace:1",
          "title": "craft-project-task-123",
          "metadata": {
            "craft:schema-version": "1",
            "craft:project-id": "project",
            "craft:project-dir": "/tmp/project",
            "craft:task-id": "task-123",
            "craft:task-dir": "/tmp/project/tasks/task-123"
          },
          "panes": [
            {
              "ref": "pane:1",
              "surfaces": [
                {
                  "ref": "surface:1",
                  "type": "terminal",
                  "title": "task-123",
                  "metadata": {
                    "craft:schema-version": "1",
                    "craft:semantic": "agent",
                    "craft:type": "terminal",
                    "craft:purpose": "agent",
                    "craft:title": "task-123",
                    "craft:placement": "left"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
JSON
fi

save() {
    local tmp
    tmp="$(mktemp)"
    jq "$@" "$STATE" > "$tmp"
    mv "$tmp" "$STATE"
}

workspace_arg() {
    local prev=""
    for arg in "$@"; do
        if [[ "$prev" == "--workspace" ]]; then
            echo "$arg"
            return 0
        fi
        prev="$arg"
    done
    return 1
}

pane_arg() {
    local prev=""
    for arg in "$@"; do
        if [[ "$prev" == "--pane" ]]; then
            echo "$arg"
            return 0
        fi
        prev="$arg"
    done
    return 1
}

surface_arg() {
    local prev=""
    for arg in "$@"; do
        if [[ "$prev" == "--surface" ]]; then
            echo "$arg"
            return 0
        fi
        prev="$arg"
    done
    return 1
}

url_arg() {
    local prev=""
    for arg in "$@"; do
        if [[ "$prev" == "--url" ]]; then
            echo "$arg"
            return 0
        fi
        prev="$arg"
    done
    return 1
}

type_arg() {
    local prev=""
    for arg in "$@"; do
        if [[ "$prev" == "--type" ]]; then
            echo "$arg"
            return 0
        fi
        prev="$arg"
    done
    echo "terminal"
}

flag_value() {
    local flag="$1"
    shift
    local prev=""
    for arg in "$@"; do
        if [[ "$prev" == "$flag" ]]; then
            echo "$arg"
            return 0
        fi
        prev="$arg"
    done
    return 1
}

metadata_args_json() {
    local args_json="[]" prev=""
    for arg in "$@"; do
        if [[ "$prev" == "--metadata" ]]; then
            args_json="$(jq --arg item "$arg" '. + [$item]' <<< "$args_json")"
        fi
        prev="$arg"
    done
    echo "$args_json"
}

positional_args_json() {
    local args_json="[]" skip_next=0
    for arg in "$@"; do
        if [[ "$skip_next" -eq 1 ]]; then
            skip_next=0
            continue
        fi
        case "$arg" in
            surface|metadata|lookup|get|set|list|clear|--json)
                continue
                ;;
            --workspace|--surface|--metadata|--prefix|--value-json|--url|--type|--pane|--name|--cwd|--command|--direction|--focus|--icon|--color|--workspace-id)
                skip_next=1
                continue
                ;;
            --*)
                continue
                ;;
        esac
        args_json="$(jq --arg item "$arg" '. + [$item]' <<< "$args_json")"
    done
    echo "$args_json"
}

case "${1:-}" in
    tree)
        ws="$(workspace_arg "$@" || true)"
        if [[ -n "$ws" ]]; then
            jq --arg ws "$ws" '
                .windows |= map(.workspaces |= map(select(.ref == $ws)))
                | .windows |= map(select((.workspaces | length) > 0))
            ' "$STATE"
        else
            cat "$STATE"
        fi
        ;;
    workspace)
        sub="${2:-}"
        if [[ "$sub" == "lookup" ]]; then
            filters="$(metadata_args_json "$@")"
            jq --argjson filters "$filters" '
                def matches_filter($ws; $f):
                  ($f | split("=")) as $parts
                  | ($parts[0]) as $key
                  | ($parts[1:] | join("=")) as $value
                  | (($ws.metadata[$key] // "") | tostring) == $value;
                {
                  matches: [
                    .windows[].workspaces[]
                    | . as $ws
                    | select(all($filters[]; matches_filter($ws; .)))
                    | {ref, id: .ref, workspace_ref: .ref, workspace_id: .ref, title, attached: (.attached // true), detached: (.detached // false)}
                  ]
                }
            ' "$STATE"
        else
            echo "fake-cmux: unsupported command: $*" >&2
            exit 2
        fi
        ;;
    metadata)
        sub="${2:-}"
        ws="$(workspace_arg "$@")"
        case "$sub" in
            get)
                key="${@: -2:1}"
                if [[ "$key" == "--json" ]]; then key="${@: -3:1}"; fi
                jq --arg ws "$ws" --arg key "$key" '
                    .windows[].workspaces[]
                    | select(.ref == $ws)
                    | {key: $key, value: (.metadata[$key] // null)}
                ' "$STATE"
                ;;
            set)
                key="${@: -2:1}"
                value="${@: -1}"
                if [[ "$key" == "--value-json" ]]; then
                    key="${@: -3:1}"
                    save --arg ws "$ws" --arg key "$key" --argjson value "$value" '
                        (.windows[].workspaces[] | select(.ref == $ws).metadata[$key]) = $value
                    '
                else
                    save --arg ws "$ws" --arg key "$key" --arg value "$value" '
                        (.windows[].workspaces[] | select(.ref == $ws).metadata[$key]) = $value
                    '
                fi
                ;;
            clear)
                key="${@: -1}"
                save --arg ws "$ws" --arg key "$key" '
                    del(.windows[].workspaces[] | select(.ref == $ws).metadata[$key])
                '
                ;;
            *)
                echo "fake-cmux: unsupported command: $*" >&2
                exit 2
                ;;
        esac
        ;;
    surface)
        sub="${2:-}"
        if [[ "$sub" == "lookup" ]]; then
            ws="$(workspace_arg "$@")"
            filters="$(metadata_args_json "$@")"
            jq --arg ws "$ws" --argjson filters "$filters" '
                def matches_filter($s; $f):
                  ($f | split("=")) as $parts
                  | ($parts[0]) as $key
                  | ($parts[1:] | join("=")) as $value
                  | (($s.metadata[$key] // "") | tostring) == $value;
                {
                  matches: [
                    .windows[].workspaces[]
                    | select(.ref == $ws)
                    | . as $workspace
                    | .panes[].surfaces[]
                    | . as $surface
                    | select(all($filters[]; matches_filter($surface; .)))
                    | $surface + {
                        id: ($surface.id // $surface.ref),
                        surface_id: ($surface.surface_id // $surface.ref),
                        surface_ref: ($surface.surface_ref // $surface.ref),
                        workspace_ref: $workspace.ref,
                        workspace_id: ($workspace.id // $workspace.ref)
                      }
                  ]
                }
            ' "$STATE"
            exit 0
        fi
        if [[ "$sub" == "metadata" ]]; then
            action="${3:-}"
            ws="$(workspace_arg "$@")"
            surface="$(surface_arg "$@")"
            positional="$(positional_args_json "$@")"
            case "$action" in
                get)
                    key="$(jq -r '.[0] // empty' <<< "$positional")"
                    jq --arg ws "$ws" --arg surface "$surface" --arg key "$key" '
                        .windows[].workspaces[]
                        | select(.ref == $ws)
                        | .panes[].surfaces[]
                        | select(.ref == $surface)
                        | {key: $key, value: (.metadata[$key] // null)}
                    ' "$STATE"
                    ;;
                set)
                    key="$(jq -r '.[0] // empty' <<< "$positional")"
                    value="$(jq -r '.[1] // empty' <<< "$positional")"
                    save --arg ws "$ws" --arg surface "$surface" --arg key "$key" --arg value "$value" '
                        (.windows[].workspaces[] | select(.ref == $ws).panes[].surfaces[] | select(.ref == $surface).metadata[$key]) = $value
                    '
                    ;;
                list)
                    prefix="$(flag_value --prefix "$@" || true)"
                    jq --arg ws "$ws" --arg surface "$surface" --arg prefix "$prefix" '
                        .windows[].workspaces[]
                        | select(.ref == $ws)
                        | .panes[].surfaces[]
                        | select(.ref == $surface)
                        | (.metadata // {})
                        | to_entries
                        | map(select($prefix == "" or (.key | startswith($prefix))))
                    ' "$STATE"
                    ;;
                clear)
                    key="$(jq -r '.[0] // empty' <<< "$positional")"
                    save --arg ws "$ws" --arg surface "$surface" --arg key "$key" '
                        del(.windows[].workspaces[] | select(.ref == $ws).panes[].surfaces[] | select(.ref == $surface).metadata[$key])
                    '
                    ;;
                *)
                    echo "fake-cmux: unsupported command: $*" >&2
                    exit 2
                    ;;
            esac
            exit 0
        fi
        echo "fake-cmux: unsupported command: $*" >&2
        exit 2
        ;;
    ssh)
        ws="workspace:$(jq -r '.next_workspace' "$STATE")"
        pane="pane:$(jq -r '.next_pane' "$STATE")"
        surface="surface:$(jq -r '.next_surface' "$STATE")"
        title="$(flag_value --name "$@" || true)"
        save --arg ws "$ws" --arg pane "$pane" --arg surface "$surface" --arg title "$title" '
            .next_workspace += 1
            | .next_pane += 1
            | .next_surface += 1
            | .windows[0].workspaces += [{
                ref: $ws,
                id: $ws,
                title: $title,
                metadata: {},
                panes: [{ref: $pane, surfaces: [{ref: $surface, type: "terminal", title: "", metadata: {}}]}]
              }]
        '
        if [[ " $* " == *" --json "* ]]; then
            jq -n --arg workspace_id "$ws" --arg workspace_ref "$ws" --arg surface_id "$surface" --arg surface_ref "$surface" \
                '{workspace_id:$workspace_id, workspace_ref:$workspace_ref, surface_id:$surface_id, surface_ref:$surface_ref}'
        else
            echo "OK workspace=$ws"
        fi
        ;;
    ssh-workspace-attach)
        workspace_id="$(flag_value --workspace-id "$@" || true)"
        ws="workspace:$workspace_id"
        save --arg ws "$ws" '
            (.windows[].workspaces[] | select(.ref == $ws).attached) = true
            | (.windows[].workspaces[] | select(.ref == $ws).detached) = false
        '
        if [[ " $* " == *" --json "* ]]; then
            jq -n --arg workspace_id "$workspace_id" --arg local_workspace_id "$ws" \
                '{workspace_id:$workspace_id, local_workspace_id:$local_workspace_id, already_attached:false}'
        else
            echo "OK $ws"
        fi
        ;;
    new-workspace)
        ws="workspace:$(jq -r '.next_workspace' "$STATE")"
        pane="pane:$(jq -r '.next_pane' "$STATE")"
        surface="surface:$(jq -r '.next_surface' "$STATE")"
        save --arg ws "$ws" --arg pane "$pane" --arg surface "$surface" '
            .next_workspace += 1
            | .next_pane += 1
            | .next_surface += 1
            | .windows[0].workspaces += [{
                ref: $ws,
                title: "",
                metadata: {},
                panes: [{ref: $pane, surfaces: [{ref: $surface, type: "terminal", title: ""}]}]
              }]
        '
        echo "OK $ws"
        ;;
    new-split)
        ws="$(workspace_arg "$@")"
        pane="pane:$(jq -r '.next_pane' "$STATE")"
        surface="surface:$(jq -r '.next_surface' "$STATE")"
        save --arg ws "$ws" --arg pane "$pane" --arg surface "$surface" '
            .next_pane += 1
            | .next_surface += 1
            | (.windows[].workspaces[] | select(.ref == $ws).panes) +=
              [{ref: $pane, surfaces: [{ref: $surface, type: "terminal", title: "", metadata: {}}]}]
        '
        echo "OK $surface $ws"
        ;;
    new-pane)
        ws="$(workspace_arg "$@")"
        url="$(url_arg "$@" || true)"
        kind="$(type_arg "$@")"
        pane="pane:$(jq -r '.next_pane' "$STATE")"
        surface="surface:$(jq -r '.next_surface' "$STATE")"
        save --arg ws "$ws" --arg pane "$pane" --arg surface "$surface" --arg url "$url" --arg kind "$kind" '
            .next_pane += 1
            | .next_surface += 1
            | (.windows[].workspaces[] | select(.ref == $ws).panes) +=
              [{ref: $pane, surfaces: [{ref: $surface, type: $kind, title: "", url: $url, metadata: {}}]}]
        '
        echo "OK $surface $pane $ws"
        ;;
    new-surface)
        pane="$(pane_arg "$@" || true)"
        ws="$(workspace_arg "$@" || true)"
        url="$(url_arg "$@" || true)"
        kind="$(type_arg "$@")"
        surface="surface:$(jq -r '.next_surface' "$STATE")"
        if [[ -z "$pane" && -n "$ws" ]]; then
            pane="$(jq -r --arg ws "$ws" '.windows[].workspaces[] | select(.ref == $ws).panes[0].ref' "$STATE")"
        fi
        save --arg pane "$pane" --arg surface "$surface" --arg url "$url" --arg kind "$kind" '
            .next_surface += 1
            | (.windows[].workspaces[].panes[] | select(.ref == $pane).surfaces) +=
              [{ref: $surface, type: $kind, title: "", url: $url, metadata: {}}]
        '
        if [[ " $* " == *" --json "* ]]; then
            jq -n --arg surface_id "$surface" '{surface_id: $surface_id}'
        else
            echo "OK $surface"
        fi
        ;;
    rename-workspace)
        ws="$(workspace_arg "$@")"
        title="${@: -1}"
        save --arg ws "$ws" --arg title "$title" '
            (.windows[].workspaces[] | select(.ref == $ws).title) = $title
        '
        ;;
    rename-tab)
        ws="$(workspace_arg "$@")"
        surface="$(surface_arg "$@")"
        title="${@: -1}"
        save --arg ws "$ws" --arg surface "$surface" --arg title "$title" '
            (.windows[].workspaces[] | select(.ref == $ws).panes[].surfaces[] | select(.ref == $surface).title) = $title
        '
        ;;
    close-surface)
        surface="$(surface_arg "$@" || true)"
        [[ -n "$surface" ]] || surface="${2:-}"
        save --arg surface "$surface" '
            (.windows[].workspaces[].panes[].surfaces) |= map(select(.ref != $surface))
        '
        ;;
    close-workspace)
        ws="$(workspace_arg "$@" || true)"
        [[ -n "$ws" ]] || ws="${2:-}"
        save --arg ws "$ws" '
            (.windows[].workspaces) |= map(select(.ref != $ws))
        '
        ;;
    focus-surface)
        surface="$(surface_arg "$@" || true)"
        [[ -n "$surface" ]] || surface="${2:-}"
        save --arg surface "$surface" '.focused = $surface'
        ;;
    browser)
        surface="${2:-}"
        sub="${3:-}"
        if [[ "$sub" == "navigate" ]]; then
            url="${4:-}"
            save --arg surface "$surface" --arg url "$url" '
                (.windows[].workspaces[].panes[].surfaces[] | select(.ref == $surface).url) = $url
            '
        fi
        ;;
    send)
        ws="$(workspace_arg "$@")"
        surface="$(surface_arg "$@")"
        text="${@: -1}"
        save --arg ws "$ws" --arg surface "$surface" --arg text "$text" '
            .sent += [{workspace: $ws, surface: $surface, text: $text}]
        '
        ;;
    set-status)
        if [[ "${FAKE_CMUX_FAIL_SET_STATUS:-}" == "1" ]]; then
            echo "fake-cmux: set-status failed" >&2
            exit 1
        fi
        key="${2:-}"
        value="${3:-}"
        ws="$(workspace_arg "$@")"
        icon="$(flag_value --icon "$@" || true)"
        color="$(flag_value --color "$@" || true)"
        save --arg ws "$ws" --arg key "$key" --arg value "$value" --arg icon "$icon" --arg color "$color" '
            (.windows[].workspaces[] | select(.ref == $ws).status[$key]) = {
              value: $value,
              icon: $icon,
              color: $color
            }
        '
        ;;
    send-key|workspace-action|move-workspace-to-window|select-workspace|clear-status)
        ;;
    list-status)
        ;;
    *)
        echo "fake-cmux: unsupported command: $*" >&2
        exit 2
        ;;
esac
