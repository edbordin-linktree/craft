#!/usr/bin/env bash
#
# open-pr-surface — Open or focus a GitHub PR browser surface for this task.
#
# Usage:
#   open-pr-surface <pr-url> [--repo <worktree>]

set -uo pipefail

URL="${1:-}"
[[ -n "$URL" && "$URL" != --* ]] || { echo "Usage: open-pr-surface <pr-url> [--repo <worktree>]" >&2; exit 2; }
shift

REPO="$(pwd)"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo) REPO="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "open-pr-surface: unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$REPO" || { echo "open-pr-surface: repo not accessible: $REPO" >&2; exit 1; }
REPO="$(pwd -P)"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
# shellcheck source=bin/lib/task-runtime.sh
source "${CRAFT_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}/bin/lib/task-runtime.sh"

TASK_ID="$(orchestrator_task_id_from_worktree "$REPO")"
TITLE="pr"
if [[ "$URL" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
    TITLE="pr:${BASH_REMATCH[2]}#${BASH_REMATCH[3]}"
fi

SURFACE_OUTPUT="$(orchestrator_surface_open "$REPO" "$TASK_ID" github-pr \
    --url "$URL" --label "$TITLE" --owner babysit-pr --stage pr_review --url-match prefix 2>&1)" || {
    echo "open-pr-surface: craft surface open failed: $SURFACE_OUTPUT" >&2
    exit 1
}

SID="$(printf '%s\n' "$SURFACE_OUTPUT" | grep -oE 'surface:[0-9]+' | head -1)"
[[ -n "$SID" ]] && printf 'open-pr-surface.surface=%s\n' "$SID"
printf 'open-pr-surface.status=opened\n'
printf 'open-pr-surface.url=%s\n' "$URL"
