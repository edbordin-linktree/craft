#!/usr/bin/env bash
#
# diffhub-server — Exec the standalone diffhub web server.
#
# Intended to be launched by bin/run-bg from a task worktree.

set -uo pipefail

REPO=""
PORT="${DIFFHUB_PORT:-2047}"
VERSION="0.1.23"
SOURCE_DIR=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)    REPO="$2"; shift 2 ;;
        --port)    PORT="$2"; shift 2 ;;
        --version) VERSION="$2"; shift 2 ;;
        --source)  SOURCE_DIR="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "diffhub-server: unknown arg: $1" >&2; exit 2 ;;
    esac
done

[[ -n "$REPO" ]] || { echo "--repo is required" >&2; exit 2; }

if [[ -n "$SOURCE_DIR" ]]; then
    cd "$SOURCE_DIR" || { echo "diffhub-server: source dir not accessible: $SOURCE_DIR" >&2; exit 1; }
    export DIFFHUB_REPO="$REPO"
    exec npm exec --workspace apps/cli diffhub -- serve --repo "$REPO" --port "$PORT" --no-open
fi

cd "$REPO" || { echo "diffhub-server: repo not accessible: $REPO" >&2; exit 1; }
exec npx -y "diffhub@${VERSION}" serve --repo "$REPO" --port "$PORT" --no-open
