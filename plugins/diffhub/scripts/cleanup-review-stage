#!/usr/bin/env bash
#
# cleanup-review-stage — Tear down everything started by the diffhub plugin:
# stop the comment watcher, then stop diffhub itself + close its cmux surface.
#
# Safe to call multiple times.
#
# Usage:
#   cleanup-review-stage [--repo <dir>]

set -uo pipefail

REPO="$(pwd)"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)    REPO="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "cleanup-review-stage: unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$REPO" || { echo "cleanup-review-stage: repo not accessible: $REPO" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Stop the background watcher.
"${CRAFT_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}/bin/run-bg" stop babysit-diffhub >/dev/null 2>&1 || true

# Stop diffhub itself + close its cmux surface.
"$SCRIPT_DIR/teardown-diffhub" --repo "$REPO"
