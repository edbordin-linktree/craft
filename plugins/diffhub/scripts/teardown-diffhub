#!/usr/bin/env bash
#
# teardown-diffhub — Stop the diffhub server and (under cmux) close its
# browser surface so the operator's view doesn't sit on stale data after local
# review ends.
#
# Stops the background helper and closes the browser surface. Safe to call
# multiple times.
#
# Usage:
#   teardown-diffhub [--repo <dir>]

set -uo pipefail

REPO="$(pwd)"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)    REPO="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "teardown-diffhub: unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$REPO" || { echo "teardown-diffhub: repo not accessible: $REPO" >&2; exit 1; }
REPO="$(pwd -P)"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
# shellcheck source=bin/lib/task-runtime.sh
source "${CRAFT_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}/bin/lib/task-runtime.sh"
CRAFT_HOME="$(orchestrator_craft_root)"
TASK_ID="$(orchestrator_task_id_from_worktree "$REPO")"

URL_FILE=".orchestrator/diffhub.url"

"$CRAFT_HOME/bin/run-bg" stop diffhub >/dev/null 2>&1 || true

orchestrator_surface_close "$REPO" "$TASK_ID" diffhub-review >/dev/null 2>&1 || true

rm -f "$URL_FILE"

exit 0
