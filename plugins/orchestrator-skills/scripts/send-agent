#!/usr/bin/env bash
#
# send-agent — Deliver a message to a named agent, spawning or resuming as needed.
#
# Three lifecycle branches collapse into one entry point:
#   1) Pane alive          → craft-mux send <name> "$msg"            (mid-flight)
#   2) Session id recorded → spawn claude/codex resume <id> with msg (resurrected)
#   3) Neither             → spawn agent fresh with msg              (first call)
#
# Standardised sentinel layout (per-name) under .orchestrator/sessions/:
#   <name>.id     — session id (written by claude; captured externally for codex)
#   <name>.done   — touched by the agent when it has written its handoff
#   <name>.lock   — directory lock (mkdir is atomic) for serialising callers
#   <name>.msg    — the (augmented) message passed to the agent
#
# Usage:
#   send-agent <name> --agent <claude|codex> --worktree <abs-path>
#              [--model <model>] [--message TEXT | --message-file PATH]
#              [--no-wait] [--timeout SECONDS]
#
# Exits 0 on success (with done sentinel touched and session id captured when
# possible). Non-zero on lock timeout, spawn failure, or wait timeout.

set -uo pipefail

if [[ ${BASH_VERSINFO[0]:-0} -lt 4 ]]; then
    echo "send-agent requires bash 4+" >&2; exit 1
fi
command -v craft-mux >/dev/null || { echo "send-agent: craft-mux not on PATH" >&2; exit 1; }

NAME=""
AGENT=""
WORKTREE=""
MODEL=""
MESSAGE=""
MESSAGE_FILE=""
NO_WAIT=false
TIMEOUT=3600
LOCK_TIMEOUT=120

while [[ $# -gt 0 ]]; do
    case "$1" in
        --agent)         AGENT="$2"; shift 2 ;;
        --worktree)      WORKTREE="$2"; shift 2 ;;
        --model)         MODEL="$2"; shift 2 ;;
        --message)       MESSAGE="$2"; shift 2 ;;
        --message-file)  MESSAGE_FILE="$2"; shift 2 ;;
        --no-wait)       NO_WAIT=true; shift ;;
        --timeout)       TIMEOUT="$2"; shift 2 ;;
        -h|--help)       sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        -*)              echo "send-agent: unknown flag: $1" >&2; exit 2 ;;
        *)
            if [[ -z "$NAME" ]]; then NAME="$1"; shift
            else echo "send-agent: unexpected positional: $1" >&2; exit 2; fi
            ;;
    esac
done

[[ -n "$NAME" ]]     || { echo "send-agent: <name> required" >&2; exit 2; }
[[ -n "$AGENT" ]]    || { echo "send-agent: --agent required" >&2; exit 2; }
[[ -n "$WORKTREE" ]] || { echo "send-agent: --worktree required" >&2; exit 2; }
[[ -d "$WORKTREE" ]] || { echo "send-agent: worktree not found: $WORKTREE" >&2; exit 1; }

case "$AGENT" in
    claude|codex) ;;
    *) echo "send-agent: --agent must be 'claude' or 'codex' (got '$AGENT')" >&2; exit 2 ;;
esac

if [[ -n "$MESSAGE" && -n "$MESSAGE_FILE" ]]; then
    echo "send-agent: --message and --message-file are mutually exclusive" >&2; exit 2
fi
if [[ -z "$MESSAGE" && -z "$MESSAGE_FILE" ]]; then
    echo "send-agent: --message or --message-file required" >&2; exit 2
fi
if [[ -n "$MESSAGE_FILE" ]]; then
    [[ -f "$MESSAGE_FILE" ]] || { echo "send-agent: message file not found: $MESSAGE_FILE" >&2; exit 1; }
    MESSAGE="$(cat "$MESSAGE_FILE")"
fi

cd "$WORKTREE"
SESSIONS_DIR="$WORKTREE/.orchestrator/sessions"
mkdir -p "$SESSIONS_DIR"
ID_FILE="$SESSIONS_DIR/$NAME.id"
DONE_FILE="$SESSIONS_DIR/$NAME.done"
LOCK_DIR="$SESSIONS_DIR/$NAME.lock"
MSG_FILE="$SESSIONS_DIR/$NAME.msg"

# --- lock (mkdir is atomic; works without external `flock`) ---
waited=0
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    sleep 1
    ((waited+=1))
    if (( waited >= LOCK_TIMEOUT )); then
        echo "send-agent: lock timeout on $LOCK_DIR (another send-agent for '$NAME' running?)" >&2
        exit 1
    fi
done
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

# --- classify state ---
PANE_ALIVE=false
SESSION_ID=""
if craft-mux exists "$NAME" 2>/dev/null; then
    PANE_ALIVE=true
fi
if [[ -s "$ID_FILE" ]]; then
    SESSION_ID="$(cat "$ID_FILE" | tr -d '\n\r' | head -c 256)"
fi

# --- augment the message with sentinel instructions ---
# The footer depends on whether the agent should exit (one-shot resume / fresh
# spawn) or stay alive (mid-flight live-pane follow-up).
if $PANE_ALIVE; then
    FOOTER="

---
When you finish this follow-up, touch '.orchestrator/sessions/$NAME.done' and
reply with only \"ok\". Stay alive for further messages."
elif [[ -n "$SESSION_ID" ]]; then
    FOOTER="

---
When you finish this work, touch '.orchestrator/sessions/$NAME.done', reply
with only \"ok\", then /exit."
else
    # First spawn — also ask the agent to record its session id (claude can;
    # codex can't, so we capture it externally after the done sentinel).
    case "$AGENT" in
        claude)
            FOOTER="

---
As one of your first actions, write your Claude session id to
'.orchestrator/sessions/$NAME.id' so the supervisor can resume you later.
When you finish this work, touch '.orchestrator/sessions/$NAME.done', reply
with only \"ok\", then /exit."
            ;;
        codex)
            FOOTER="

---
When you finish this work, touch '.orchestrator/sessions/$NAME.done', reply
with only \"ok\", then /exit. (The supervisor captures your session id from
~/.codex/sessions/ after you exit.)"
            ;;
    esac
fi
printf '%s%s\n' "$MESSAGE" "$FOOTER" > "$MSG_FILE"

# Clear stale done sentinel — we wait for THIS message's completion.
rm -f "$DONE_FILE"

# --- snapshot codex sessions dir before spawning a fresh codex session ---
CODEX_SNAPSHOT_BEFORE=""
if [[ "$AGENT" == "codex" && -z "$SESSION_ID" && ! $PANE_ALIVE ]]; then
    CODEX_SNAPSHOT_BEFORE="$(mktemp)"
    ls ~/.codex/sessions/ 2>/dev/null | sort > "$CODEX_SNAPSHOT_BEFORE" || true
fi

# --- dispatch ---
if $PANE_ALIVE; then
    echo "[send-agent] '$NAME' pane alive — sending follow-up" >&2
    # Single message body, multi-line — craft-mux send delivers as-is + Enter.
    craft-mux send "$NAME" "$(cat "$MSG_FILE")"
elif [[ -n "$SESSION_ID" ]]; then
    echo "[send-agent] resuming '$NAME' (session $SESSION_ID)" >&2
    case "$AGENT" in
        claude)
            craft-mux spawn "$NAME" "$WORKTREE" \
                claude --resume "$SESSION_ID" --dangerously-skip-permissions \
                "\"\$(cat '$MSG_FILE')\""
            ;;
        codex)
            craft-mux spawn "$NAME" "$WORKTREE" \
                codex resume "$SESSION_ID" \
                "\"\$(cat '$MSG_FILE')\""
            ;;
    esac
else
    echo "[send-agent] spawning fresh '$NAME' ($AGENT)" >&2
    case "$AGENT" in
        claude)
            craft-mux spawn "$NAME" "$WORKTREE" \
                claude --dangerously-skip-permissions ${MODEL:+--model "$MODEL"} \
                "\"\$(cat '$MSG_FILE')\""
            ;;
        codex)
            craft-mux spawn "$NAME" "$WORKTREE" \
                codex --dangerously-bypass-approvals-and-sandbox ${MODEL:+--model "$MODEL"} \
                "\"\$(cat '$MSG_FILE')\""
            ;;
    esac
fi

if $NO_WAIT; then
    echo "[send-agent] --no-wait: returning before done sentinel" >&2
    exit 0
fi

# --- wait for done sentinel ---
echo "[send-agent] waiting for $DONE_FILE (timeout ${TIMEOUT}s)..." >&2
waited=0
while [[ ! -f "$DONE_FILE" ]]; do
    sleep 5
    ((waited+=5))
    if (( waited >= TIMEOUT )); then
        echo "[send-agent] timeout waiting for done sentinel" >&2
        exit 124
    fi
done
echo "[send-agent] done sentinel detected after ${waited}s" >&2

# --- post-completion: capture codex session id by diffing sessions dir ---
if [[ -n "$CODEX_SNAPSHOT_BEFORE" && ! -s "$ID_FILE" ]]; then
    NEW_FILE="$(ls ~/.codex/sessions/ 2>/dev/null | sort | comm -23 - "$CODEX_SNAPSHOT_BEFORE" | head -1)"
    if [[ -n "$NEW_FILE" ]]; then
        echo "${NEW_FILE%.jsonl}" > "$ID_FILE"
        echo "[send-agent] captured codex session id: $(cat "$ID_FILE")" >&2
    else
        echo "[send-agent] WARNING: could not capture codex session id; resume may need manual lookup" >&2
    fi
    rm -f "$CODEX_SNAPSHOT_BEFORE"
fi

exit 0
