#!/usr/bin/env bash
#
# await-diffhub-review — Block until either:
#   - .orchestrator/diffhub-pending.md has comments to process, OR
#   - .orchestrator/ready-for-pr sentinel appears (human signal OR babysit's
#     idle-timeout self-touch).
#
# When pending content appears, this script drains it to stdout and exits 0
# (caller should act on each bullet, then call this script again to re-block).
# When the sentinel appears, exits 2 (caller should advance to the PR stage).
#
# This is the foreground wake-up loop for the diffhub-review phase: the agent
# runs it as a single Bash tool call, blocks cheaply on `sleep`, and gets
# either work to do (stdout) or a signal to advance (exit 2). No agent tokens
# burned while waiting.
#
# Usage:
#   await-diffhub-review [--repo <dir>] [--interval <seconds>]

set -uo pipefail

REPO="$(pwd)"
INTERVAL=5

while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)     REPO="$2"; shift 2 ;;
        --interval) INTERVAL="$2"; shift 2 ;;
        -h|--help)  sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "await-diffhub-review: unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$REPO" || { echo "await-diffhub-review: repo not accessible: $REPO" >&2; exit 1; }

PENDING=".orchestrator/diffhub-pending.md"
SENTINEL=".orchestrator/ready-for-pr"

until [[ -s "$PENDING" ]] || [[ -f "$SENTINEL" ]]; do
    sleep "$INTERVAL"
done

if [[ -f "$SENTINEL" ]]; then
    exit 2
fi

cat "$PENDING"
: > "$PENDING"
exit 0
