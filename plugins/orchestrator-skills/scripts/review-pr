#!/usr/bin/env bash
#
# review-pr — Cross-model PR review wrapper.
#
# Spawns a reviewer sub-agent (different model than the one that wrote the
# code) in headless mode, asks it to invoke the local review-pr skill rubric,
# and writes findings to two places:
#   1. .orchestrator/handoff/review.md          — for the coding agent to act on
#   2. diffhub's /api/comments REST API          — inline comments visible in
#                                                   diffhub UI for the human
#
# Usage:
#   review-pr [--base <ref>] [--worktree <abs-path>]
#             [--reviewer claude|codex|cursor|gemini]
#             [--model <model>]
#             [--output <path>]
#             [--diffhub-url <url>]
#             [--tag <tag-string>]
#
# Defaults:
#   --base             auto-detect from origin/HEAD (the repo's default branch)
#   --worktree         $(pwd)
#   --reviewer         claude
#   --model            sonnet (for claude)
#   --output           <worktree>/.orchestrator/handoff/review.md
#   --diffhub-url      value from <worktree>/.orchestrator/diffhub.url
#   --tag              automated-review:<reviewer>-<model> (recorded in body;
#                      diffhub tag field is restricted to known labels)
#
# Reviews the LOCAL branch diff (HEAD vs --base) — not a GitHub PR. The
# diffhub-review phase runs before the PR is opened, so there is nothing to
# review on GitHub yet, and `gh pr view` for a re-used branch name can
# return a stale CLOSED PR and send the reviewer chasing the wrong diff.
#
# Requires: bash 4+, gh, jq, curl, plus the chosen reviewer CLI on PATH.
#
# TODO: --reviewer is parsed but only `claude` is wired up. Add `codex`,
#       `cursor`, and `gemini` dispatch so the token load can spread across
#       providers. Each provider has a different headless invocation:
#         - codex:  `codex --dangerously-bypass-approvals-and-sandbox <prompt>`
#                    (but codex is interactive by default — needs a one-shot
#                     mode; `codex resume` against a fresh session is the
#                     closest current path).
#         - cursor: `cursor-agent -p <prompt>` (verify exact flag)
#         - gemini: `gemini -p <prompt>` (verify exact flag)
#
# TODO: support multiple parallel reviewers in one invocation
#       (--reviewer claude --reviewer codex). Each spawns in parallel via `&`,
#       writes its findings to a per-reviewer temp file with a distinct
#       tag value, then this script imports them through diffhub's comments
#       API in one request. Sketch:
#           for r in "${REVIEWERS[@]}"; do
#               spawn_reviewer "$r" > ".orchestrator/handoff/review.$r.json" &
#           done
#           wait
#           jq -s 'reduce .[] as $f ([]; . + $f.findings)' \
#               .orchestrator/handoff/review.*.json > merged.json
#           # ...then build comments and POST {comments:[...]} to /api/comments

set -uo pipefail

if [[ ${BASH_VERSINFO[0]:-0} -lt 4 ]]; then
    echo "review-pr requires bash 4+" >&2; exit 1
fi
command -v jq >/dev/null   || { echo "review-pr: jq is required" >&2; exit 1; }
command -v curl >/dev/null || { echo "review-pr: curl is required" >&2; exit 1; }
command -v git >/dev/null  || { echo "review-pr: git is required" >&2; exit 1; }

# --- args ---
BASE=""
WORKTREE="$(pwd)"
REVIEWER="claude"
MODEL=""
OUTPUT=""
DH_URL=""
TAG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --base)             BASE="$2"; shift 2 ;;
        --worktree)         WORKTREE="$2"; shift 2 ;;
        --reviewer)         REVIEWER="$2"; shift 2 ;;
        --model)            MODEL="$2"; shift 2 ;;
        --output)           OUTPUT="$2"; shift 2 ;;
        --diffhub-url)      DH_URL="$2"; shift 2 ;;
        --diffhub-comments) echo "review-pr: --diffhub-comments is no longer supported; use --diffhub-url" >&2; exit 2 ;;
        --tag)              TAG="$2"; shift 2 ;;
        -h|--help)
            sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'
            exit 0
            ;;
        *) echo "review-pr: unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$WORKTREE" || { echo "review-pr: worktree not accessible: $WORKTREE" >&2; exit 1; }

# Auto-detect base branch from origin/HEAD if not provided.
if [[ -z "$BASE" ]]; then
    BASE="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)" \
        || { echo "review-pr: could not auto-detect base branch; pass --base" >&2; exit 1; }
fi

# Resolve to the merge-base so the diff is exactly "what HEAD adds on top of base".
MERGE_BASE="$(git merge-base HEAD "$BASE" 2>/dev/null)" \
    || { echo "review-pr: could not find merge-base of HEAD and $BASE" >&2; exit 1; }

# Defaults that depend on args
[[ -n "$MODEL" ]]   || case "$REVIEWER" in claude) MODEL="sonnet" ;; esac
[[ -n "$OUTPUT" ]]  || OUTPUT="$WORKTREE/.orchestrator/handoff/review.md"
[[ -n "$DH_URL" ]]  || DH_URL="$(cat "$WORKTREE/.orchestrator/diffhub.url" 2>/dev/null || true)"
[[ -n "$TAG" ]]     || TAG="automated-review:${REVIEWER}${MODEL:+-$MODEL}"
PENDING_FILE="$WORKTREE/.orchestrator/diffhub-pending.md"
STATUS_FILE="$WORKTREE/.orchestrator/review-pr-status.md"

mkdir -p "$(dirname "$OUTPUT")" "$WORKTREE/.orchestrator"

log() { printf '%s [review-pr] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
log "reviewing HEAD vs $BASE (merge-base=${MERGE_BASE:0:8}) — reviewer=$REVIEWER model=$MODEL tag=$TAG"

write_import_failure_status() {
    local reason="$1"
    local detail="$2"

    {
        printf '### Diffhub Import Failed — %s\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf -- '- Reason: %s\n' "$reason"
        printf -- '- Detail: %s\n' "$detail"
        printf -- '- Findings: %s\n' "$FINDINGS_COUNT"
        printf -- '- Handoff: %s\n\n' "$OUTPUT"
    } >> "$STATUS_FILE" 2>/dev/null || true
}

write_pending_findings() {
    echo "$JSON" | jq -r --arg source "$TAG" '
        .findings[] |
        (if .severity == "critical" or .severity == "major" then "[must-fix]"
         elif .severity == "nitpick" then "[nit]"
         elif .severity == "minor" then "[suggestion]"
         else "[suggestion]" end) as $tag
        | "- \($tag) comment at \(.file):\(.line): **\(.severity)** [\(.category)] \($source): \(.message | if length > 200 then .[0:197] + "..." else . end)"
    ' >> "$PENDING_FILE" 2>/dev/null || true
}

# --- build the prompt for the reviewer sub-agent ---
PROMPT="You are a senior code reviewer. Review the LOCAL branch diff in this worktree:
HEAD against base \`${BASE}\` (merge-base \`${MERGE_BASE}\`).

DO NOT use \`gh pr ...\` to fetch a diff. There may be no PR yet, or there may
be a stale closed PR on the same branch name from a previous run — both will
mislead you. Use git directly.

The repository ships a 'review-pr' skill at .claude/skills/review-pr/SKILL.md
(also at .codex/skills/review-pr/SKILL.md). Read that skill in full first —
it defines the review rubric (severity bands, security/performance/correctness
checklists, what to flag vs ignore). Apply its conventions strictly.

Fetch the diff via: git diff ${MERGE_BASE}...HEAD
File list:         git diff ${MERGE_BASE}...HEAD --name-only
Per-file diff:     git diff ${MERGE_BASE}...HEAD -- <path>
Walk the diff file-by-file.

Only include findings you are HIGH CONFIDENCE about. Suppress nitpicks unless
objectively wrong. Style preferences without a clear reason should NOT appear.

Output ONLY a JSON object with this exact shape (no preamble, no markdown
fences, no commentary — start with { and end with }):

{
  \"summary\": \"<2-3 sentence overall summary>\",
  \"findings\": [
    {
      \"file\": \"<path/from/repo/root>\",
      \"line\": <integer line number in the new (right) side of the diff>,
      \"severity\": \"critical|major|minor|nitpick\",
      \"category\": \"bug|security|performance|correctness|style\",
      \"message\": \"<one-paragraph description of the issue + a suggested fix>\"
    }
  ]
}

If the diff is clean and you have no findings, return {\"summary\": \"...\", \"findings\": []}.
"

# --- dispatch to the chosen reviewer ---
RAW_OUT=""
case "$REVIEWER" in
    claude)
        command -v claude >/dev/null || { echo "review-pr: claude CLI not on PATH" >&2; exit 1; }
        RAW_OUT="$(claude -p --model "$MODEL" --dangerously-skip-permissions "$PROMPT")" \
            || { echo "review-pr: claude exited non-zero" >&2; exit 1; }
        ;;
    codex|cursor|gemini)
        echo "review-pr: reviewer '$REVIEWER' is not wired up yet (TODO at top of script)" >&2
        exit 2
        ;;
    *)
        echo "review-pr: unknown reviewer '$REVIEWER'" >&2; exit 2 ;;
esac

# --- extract JSON from response (tolerate light wrapping) ---
JSON=""
if echo "$RAW_OUT" | jq -e . >/dev/null 2>&1; then
    JSON="$RAW_OUT"
else
    # Try to extract from a fenced ```json block, or first { ... last }
    JSON="$(printf '%s' "$RAW_OUT" | awk '
        /^```json/ {capture=1; next}
        /^```/ && capture {exit}
        capture {print}
    ')"
    if [[ -z "$JSON" ]] || ! echo "$JSON" | jq -e . >/dev/null 2>&1; then
        JSON="$(printf '%s' "$RAW_OUT" | sed -n '/^[[:space:]]*{/,/^[[:space:]]*}/p')"
    fi
fi

if ! echo "$JSON" | jq -e . >/dev/null 2>&1; then
    log "ERROR: reviewer did not return valid JSON"
    log "raw output (first 500 chars):"
    printf '%s\n' "${RAW_OUT:0:500}" >&2
    exit 1
fi

FINDINGS_COUNT="$(echo "$JSON" | jq '.findings | length')"
SUMMARY="$(echo "$JSON" | jq -r '.summary // ""')"

# --- write markdown summary for the coding agent ---
{
    echo "# Review by ${REVIEWER}${MODEL:+ ($MODEL)}"
    echo
    echo "Generated $(date -u +%Y-%m-%dT%H:%M:%SZ) — tag: \`$TAG\`"
    echo
    echo "## Summary"
    echo
    echo "$SUMMARY"
    echo
    echo "## Findings ($FINDINGS_COUNT)"
    echo
    if [[ "$FINDINGS_COUNT" -gt 0 ]]; then
        echo "$JSON" | jq -r '.findings[] |
            "### \(.severity) — \(.file):\(.line)  [\(.category)]\n\n\(.message)\n"'
    else
        echo "_No findings._"
    fi
} > "$OUTPUT"
log "wrote markdown summary to $OUTPUT"

# --- import findings as diffhub inline comments through the REST API ---
DIFFHUB_IMPORT_STATUS="skipped"
if [[ "$FINDINGS_COUNT" -gt 0 ]]; then
    if [[ -z "$DH_URL" ]]; then
        log "WARNING: diffhub URL unavailable; findings remain in $OUTPUT"
        write_import_failure_status "diffhub URL unavailable" "read $OUTPUT"
        write_pending_findings
        DIFFHUB_IMPORT_STATUS="failed:no-url"
    else
        COMMENTS_URL="${DH_URL%/}/api/comments"
        NEW_COMMENTS="$(echo "$JSON" | jq --arg source "$TAG" '
            def stable_key:
                [$source, .file, (.line | tostring), .severity, .category] | join(":");

            .findings as $findings
            | ($findings | map(stable_key)) as $keys
            | [range(0; ($findings | length)) as $i
            | $findings[$i] as $finding
            | ($keys[$i]) as $key
            | ([range(0; ($keys | length)) | select($keys[.] == $key)] | length) as $same_count
            | ([range(0; $i) | select($keys[.] == $key)] | length) as $same_before
            | $finding | {
                body: "**\(.severity)** [\(.category)] \($source): \(.message)",
                createdBy: $source,
                externalId: ($key + if $same_count > 1 and $same_before > 0 then ":duplicate-\($same_before)" else "" end),
                file: .file,
                lineNumber: .line,
                side: "right",
                tag: (if .severity == "critical" or .severity == "major" then "[must-fix]"
                      elif .severity == "nitpick" then "[nit]"
                      elif .severity == "minor" then "[suggestion]"
                      else "[suggestion]" end)
            }]
        ')"
        if IMPORT_RESPONSE="$(jq -n --argjson comments "$NEW_COMMENTS" '{comments: $comments}' |
            curl -fsS --connect-timeout 5 --max-time 30 -X POST \
                -H 'Content-Type: application/json' \
                --data-binary @- \
                "$COMMENTS_URL")"; then
            IMPORT_CREATED="$(echo "$IMPORT_RESPONSE" | jq -r '.created // 0')"
            IMPORT_EXISTING="$(echo "$IMPORT_RESPONSE" | jq -r '.existing // 0')"
            DIFFHUB_IMPORT_STATUS="created=$IMPORT_CREATED existing=$IMPORT_EXISTING"
            log "imported comments through $COMMENTS_URL ($DIFFHUB_IMPORT_STATUS)"
        else
            log "WARNING: failed to import comments via $COMMENTS_URL; findings remain in $OUTPUT"
            write_import_failure_status "POST to diffhub comments API failed" "diffhub_url=$DH_URL; read $OUTPUT"
            write_pending_findings
            DIFFHUB_IMPORT_STATUS="failed:post"
        fi
    fi
fi

# --- final stdout summary ---
printf 'review.findings=%s\n' "$FINDINGS_COUNT"
printf 'review.output=%s\n' "$OUTPUT"
printf 'review.diffhub_url=%s\n' "$DH_URL"
printf 'review.diffhub_import=%s\n' "$DIFFHUB_IMPORT_STATUS"
printf 'review.tag=%s\n' "$TAG"
