#!/usr/bin/env bash
#
# cleanup-pr-stage — Stop the watch-pr background process and clean up its
# pid file. Used by babysit-pr completion paths (merged, closed, failure).
#
# Safe to call multiple times; idempotent on missing pid files.
#
# Usage:
#   cleanup-pr-stage [--repo <dir>]

set -uo pipefail

REPO="$(pwd)"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)    REPO="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "cleanup-pr-stage: unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$REPO" || { echo "cleanup-pr-stage: repo not accessible: $REPO" >&2; exit 1; }

pidfile=".orchestrator/watch-pr.pid"
labelfile=".orchestrator/watch-pr.label"
if [[ -f "$pidfile" ]]; then
    pid=$(cat "$pidfile" 2>/dev/null || true)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
fi
if [[ -f "$labelfile" ]] && command -v launchctl >/dev/null; then
    label=$(cat "$labelfile" 2>/dev/null || true)
    if [[ -n "$label" ]]; then
        launchctl remove "$label" >/dev/null 2>&1 || true
    fi
    rm -f "$labelfile"
fi
