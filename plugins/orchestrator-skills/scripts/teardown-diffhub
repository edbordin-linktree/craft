#!/usr/bin/env bash
#
# teardown-diffhub — Stop the diffhub server and (under cmux) close its
# browser surface so the operator's view doesn't sit on stale data after the
# diffhub-review phase ends.
#
# Reads .orchestrator/diffhub.pid + .orchestrator/diffhub.surface, ignores
# missing files. Safe to call multiple times.
#
# Usage:
#   teardown-diffhub [--repo <dir>]

set -uo pipefail

REPO="$(pwd)"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)    REPO="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "teardown-diffhub: unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$REPO" || { echo "teardown-diffhub: repo not accessible: $REPO" >&2; exit 1; }
REPO="$(pwd -P)"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
# shellcheck source=plugins/orchestrator-skills/scripts/runtime-lib
source "$SCRIPT_DIR/runtime-lib"
TASK_ID="$(orchestrator_task_id_from_worktree "$REPO")"

PIDFILE=".orchestrator/diffhub.pid"
SURFACE_FILE=".orchestrator/diffhub.surface"
URL_FILE=".orchestrator/diffhub.url"
LABEL_FILE=".orchestrator/diffhub.label"

if [[ -f "$PIDFILE" ]]; then
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        # Give it a beat to exit cleanly; SIGKILL if it lingers.
        for _ in 1 2 3; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
fi

if [[ -f "$LABEL_FILE" ]] && command -v launchctl >/dev/null; then
    label=$(cat "$LABEL_FILE" 2>/dev/null || true)
    if [[ -n "$label" ]]; then
        launchctl remove "$label" >/dev/null 2>&1 || true
    fi
    rm -f "$LABEL_FILE"
fi

orchestrator_surface_close "$REPO" "$TASK_ID" diffhub-review >/dev/null 2>&1 || true
rm -f "$SURFACE_FILE"

rm -f "$URL_FILE"

exit 0
