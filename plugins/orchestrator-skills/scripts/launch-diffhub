#!/usr/bin/env bash
#
# launch-diffhub — Start diffhub as a plain Next.js dev server in the
# background, wait for it to print its URL, then (if cmux is reachable) open
# a cmux browser surface pointing at it. Emit URL / PID / surface to stdout
# and to .orchestrator/.
#
# Design notes:
#
#   • diffhub is ALWAYS started in `--no-open` (standalone) mode. We do NOT
#     use `diffhub cmux`, because that subcommand has diffhub call
#     `cmux new-surface` from inside its own process. Under launchctl the
#     diffhub process is a child of launchd (no cmux ancestor), so cmux's
#     process-tree access check denies the call and the surface is never
#     created — the user just sees a dead/empty .orchestrator/diffhub.surface.
#
#   • We create the cmux browser surface ourselves AFTER diffhub is up,
#     directly from this script. `launch-diffhub` runs in the caller's
#     shell context (the agent's bash session, a cmux descendant), so the
#     `cmux new-surface` call here is authorised. The returned surface ref
#     is captured deterministically — no log parsing needed.
#
#   • cmux capability is probed via `cmux current-window`, NOT via the
#     CMUX_WORKSPACE_ID env var. Some agent runtimes (codex Bash tool calls)
#     don't propagate CMUX_* env vars to subshells, so the env-var check
#     would skip the cmux branch even when cmux is reachable.
#
# Side effects (in the current working directory):
#   .orchestrator/diffhub.log      — diffhub stdout/stderr
#   .orchestrator/diffhub.pid      — diffhub process id
#   .orchestrator/diffhub.surface  — cmux browser surface ref (if created)
#   .orchestrator/diffhub.label    — launchctl label (Darwin path)
#   .orchestrator/diffhub.runner.sh — launchctl runner shim (Darwin path)
#
# Stdout:
#   diffhub.url=<url>
#   diffhub.pid=<pid>
#   diffhub.surface=<surface>      (only when cmux is reachable)
#
# Exit codes:
#   0  diffhub came up and printed a URL within --timeout seconds
#   1  failed to detect URL within timeout (diffhub.log still on disk for triage)
#   2  bad args
#
# Usage:
#   launch-diffhub [--repo <dir>] [--timeout <seconds>] [--version <n.n.n>] [--source <dir>] [--port <port>]

set -uo pipefail

REPO="$(pwd)"
TIMEOUT=30
VERSION="0.1.21"
PORT="${DIFFHUB_PORT:-2047}"
PORT_WAS_EXPLICIT=0
SOURCE_DIR="${DIFFHUB_SOURCE_DIR:-}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CRAFT_HOME="${CRAFT_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)    REPO="$2"; shift 2 ;;
        --timeout) TIMEOUT="$2"; shift 2 ;;
        --version) VERSION="$2"; shift 2 ;;
        --port)    PORT="$2"; PORT_WAS_EXPLICIT=1; shift 2 ;;
        --source)  SOURCE_DIR="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "launch-diffhub: unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$REPO" || { echo "launch-diffhub: repo not accessible: $REPO" >&2; exit 1; }
REPO="$(pwd -P)"
mkdir -p .orchestrator

if [[ -z "$SOURCE_DIR" && -f "$CRAFT_HOME/vendor/diffhub/apps/cli/package.json" ]]; then
    SOURCE_DIR="$(cd "$CRAFT_HOME/vendor/diffhub" && pwd -P)"
elif [[ -z "$SOURCE_DIR" && -f "../diffhub-source/apps/cli/package.json" ]]; then
    echo "launch-diffhub: ../diffhub-source is deprecated; use \$CRAFT_ROOT/vendor/diffhub" >&2
    SOURCE_DIR="$(cd "../diffhub-source" && pwd -P)"
elif [[ -n "$SOURCE_DIR" ]]; then
    SOURCE_DIR="$(cd "$SOURCE_DIR" 2>/dev/null && pwd -P)" || {
        echo "launch-diffhub: source dir not accessible: $SOURCE_DIR" >&2
        exit 1
    }
fi

if [[ -n "$SOURCE_DIR" && ! -f "$SOURCE_DIR/apps/cli/package.json" ]]; then
    echo "launch-diffhub: source dir is not a diffhub checkout: $SOURCE_DIR" >&2
    exit 1
fi

port_is_free() {
    local candidate="$1"
    if command -v lsof >/dev/null 2>&1; then
        ! lsof -nP -iTCP:"$candidate" -sTCP:LISTEN >/dev/null 2>&1
        return
    fi

    if command -v nc >/dev/null 2>&1; then
        ! nc -z 127.0.0.1 "$candidate" >/dev/null 2>&1
        return
    fi

    return 0
}

if [[ "$PORT_WAS_EXPLICIT" -eq 0 && -z "${DIFFHUB_PORT:-}" ]]; then
    ORIGINAL_PORT="$PORT"
    for candidate in $(seq "$PORT" $((PORT + 50))); do
        if port_is_free "$candidate"; then
            PORT="$candidate"
            break
        fi
    done

    if [[ "$PORT" != "$ORIGINAL_PORT" ]]; then
        echo "launch-diffhub: port $ORIGINAL_PORT is in use; using $PORT" >&2
    fi
fi

LOG=".orchestrator/diffhub.log"
PIDFILE=".orchestrator/diffhub.pid"
SURFACE_FILE=".orchestrator/diffhub.surface"
URL_FILE=".orchestrator/diffhub.url"
LABEL_FILE=".orchestrator/diffhub.label"
RUNNER=".orchestrator/diffhub.runner.sh"

# Avoid reading a stale URL from a previous launch while the new server is still
# starting. This matters when another task already owns the old port.
rm -f "$LOG" "$URL_FILE"

# --- spawn diffhub (always standalone) ---
if [[ "$(uname -s)" == "Darwin" ]] && command -v launchctl >/dev/null; then
    LABEL="craft.diffhub.$(date +%s).$$"
    BASH_BIN="$(command -v bash)"
    LOG_ABS="${REPO}/${LOG}"

    {
        printf '#!%s\n' "$BASH_BIN"
        printf 'set -uo pipefail\n'
        printf 'export PATH=%q\n' "$PATH"
        if [[ -n "$SOURCE_DIR" ]]; then
            printf 'cd %q || exit 1\n' "$SOURCE_DIR"
            printf 'export DIFFHUB_REPO=%q\n' "$REPO"
            printf 'exec npm exec --workspace apps/cli -- next dev -p %q >%q 2>&1 < /dev/null\n' \
                "$PORT" "$LOG_ABS"
        else
            printf 'cd %q || exit 1\n' "$REPO"
            printf 'exec npx -y %q --repo %q --port %q --no-open >%q 2>&1 < /dev/null\n' \
                "diffhub@${VERSION}" "$REPO" "$PORT" "$LOG_ABS"
        fi
    } > "$RUNNER"
    chmod +x "$RUNNER"

    launchctl submit -l "$LABEL" -- "$BASH_BIN" "$REPO/$RUNNER"
    echo "$LABEL" > "$LABEL_FILE"

    PID=""
    for _ in $(seq 1 20); do
        PID=$(launchctl print "gui/$(id -u)/${LABEL}" 2>/dev/null | awk '/pid = / {print $3; exit}')
        [[ -n "$PID" ]] && break
        sleep 0.1
    done
    [[ -n "$PID" ]] || { echo "launch-diffhub: launched $LABEL but could not determine pid" >&2; exit 1; }
else
    if [[ -n "$SOURCE_DIR" ]]; then
        (cd "$SOURCE_DIR" && DIFFHUB_REPO="$REPO" npm exec --workspace apps/cli -- next dev -p "$PORT") >"$LOG" 2>&1 &
    else
        npx -y "diffhub@${VERSION}" --repo "$REPO" --port "$PORT" --no-open >"$LOG" 2>&1 &
    fi
    PID=$!
fi
echo "$PID" > "$PIDFILE"

# --- wait for diffhub to print its URL ---
URL=""
for _ in $(seq 1 "$TIMEOUT"); do
    URL=$(grep -oE 'https?://(localhost|127\.0\.0\.1):[0-9]+' "$LOG" 2>/dev/null | head -1 || true)
    [[ -n "$URL" ]] && break
    sleep 1
done

if [[ -z "$URL" ]]; then
    echo "launch-diffhub: timed out after ${TIMEOUT}s waiting for URL (see $LOG)" >&2
    exit 1
fi

# The dev server can print its URL before route handlers are ready. Do not open
# the browser surface until an HTTP probe succeeds, otherwise cmux may land on a
# stale "refused to connect" page and never repaint to the app.
READY_URL="${URL%/}/api/health"
READY=""
for _ in $(seq 1 "$TIMEOUT"); do
    if curl -fsS "$READY_URL" >/dev/null 2>&1; then
        READY=1
        break
    fi
    sleep 1
done

if [[ -z "$READY" ]]; then
    echo "launch-diffhub: timed out after ${TIMEOUT}s waiting for server readiness at $READY_URL (see $LOG)" >&2
    exit 1
fi
echo "$URL" > "$URL_FILE"

# --- create the cmux browser surface ourselves (if cmux is reachable) ---
# `cmux current-window` succeeds only when the caller can talk to the cmux
# daemon (process-tree auth), so it's a direct capability test — unlike the
# CMUX_WORKSPACE_ID env-var check, which agent subshells often miss.
SURFACE=""
if command -v cmux >/dev/null && cmux current-window >/dev/null 2>&1; then
    SURFACE_OUTPUT=$(cmux browser open-split "$URL" 2>&1)
    SURFACE=$(printf '%s\n' "$SURFACE_OUTPUT" | grep -oE 'surface:[0-9]+' | head -1)
    if [[ -n "$SURFACE" ]]; then
        echo "$SURFACE" > "$SURFACE_FILE"
        cmux rename-tab --surface "$SURFACE" "diffhub" >/dev/null 2>&1 || true
    else
        # Surface this on stderr so the operator can see it (the agent will
        # log it to .orchestrator/diffhub.log via its caller).
        printf 'launch-diffhub: cmux browser open-split failed: %s\n' "$SURFACE_OUTPUT" >&2
    fi
fi

printf 'diffhub.url=%s\n' "$URL"
printf 'diffhub.pid=%s\n' "$PID"
[[ -n "$SURFACE" ]] && printf 'diffhub.surface=%s\n' "$SURFACE"
exit 0
