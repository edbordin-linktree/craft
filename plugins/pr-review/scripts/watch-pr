#!/usr/bin/env bash
#
# watch-pr — Fast-polling PR watcher for babysit-pr.
#
# Polls GitHub on a 30-second floor and enqueues typed Craft runtime events.
# Craft wakes the task agent with one compact CRAFT_EVENTS summary only when
# the pending queue flips empty -> non-empty, so token cost stays decoupled
# from polling cadence.
#
# Usage:
#   watch-pr \
#     --pr <number-or-url> \
#     --worktree <abs-path> \
#     [--poll-interval 30] \
#     [--state-file <path>] \
#
# Exits 0 when the PR merges, 1 when it closes without merging, or after
# SIGTERM/SIGINT (clean shutdown).
#
# Requires: bash 4+, gh, jq.

set -uo pipefail

if [[ ${BASH_VERSINFO[0]:-0} -lt 4 ]]; then
    echo "watch-pr requires bash 4+" >&2; exit 1
fi
command -v gh >/dev/null || { echo "watch-pr: 'gh' is required" >&2; exit 1; }
command -v jq >/dev/null || { echo "watch-pr: 'jq' is required" >&2; exit 1; }

# --- args ---
PR_INPUT=""
WORKTREE=""
POLL_INTERVAL=30
STATE_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --pr)               PR_INPUT="$2"; shift 2 ;;
        --worktree)         WORKTREE="$2"; shift 2 ;;
        --poll-interval)    POLL_INTERVAL="$2"; shift 2 ;;
        --state-file)       STATE_FILE="$2"; shift 2 ;;
        -h|--help)          sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)                  echo "watch-pr: unknown arg: $1" >&2; exit 2 ;;
    esac
done

[[ -n "$PR_INPUT" ]] || { echo "--pr is required" >&2; exit 2; }
[[ -n "$WORKTREE" ]] || { echo "--worktree is required" >&2; exit 2; }
[[ -d "$WORKTREE" ]] || { echo "worktree not found: $WORKTREE" >&2; exit 1; }

cd "$WORKTREE"
mkdir -p "$WORKTREE/.orchestrator"
STATE_FILE="${STATE_FILE:-$WORKTREE/.orchestrator/babysit-state.json}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
# shellcheck source=bin/lib/task-runtime.sh
source "${CRAFT_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}/bin/lib/task-runtime.sh"
TASK_ID="$(orchestrator_task_id_from_worktree "$WORKTREE")"

# Extract PR number from URL if needed.
PR_NUMBER="${PR_INPUT##*/}"   # last segment of URL works; bare number passes through

# Resolve owner/repo from the worktree's gh context (used by the GraphQL query).
cd "$WORKTREE" || exit 1
NAME_WITH_OWNER="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)"
if [[ -z "$NAME_WITH_OWNER" ]]; then
    echo "watch-pr: could not resolve owner/repo from $WORKTREE (is this a gh-recognised git repo?)" >&2
    exit 1
fi
OWNER="${NAME_WITH_OWNER%/*}"
REPO="${NAME_WITH_OWNER#*/}"

log() { printf '%s [watch-pr] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

event_type_for_summary() {
    local summary="$1"
    case "$summary" in
        PR\ *merged*|PR\ closed*) echo "pr_review" ;;
        *CONFLICTING*|*BEHIND*|base\ branch\ advanced*) echo "merge_status" ;;
        CI\ check*) echo "ci_status" ;;
        *review\ thread*|*inline\ comment*|*conversation\ comment*|*changes\ requested*|*review\ submission*) echo "review_comment" ;;
        *approved*) echo "pr_approval" ;;
        draft\ *) echo "pr_review" ;;
        *) echo "pr_review" ;;
    esac
}

record_transition() {
    local summary="$1" snapshot="$2"
    local type payload
    type="$(event_type_for_summary "$summary")"
    payload="$(orchestrator_payload_file "$WORKTREE" "watch-pr-event")"
    jq -n \
        --arg phase "pr_review" \
        --arg type "$type" \
        --arg summary "$summary" \
        --arg pr_number "$PR_NUMBER" \
        --arg owner "$OWNER" \
        --arg repo "$REPO" \
        --argjson snapshot "$snapshot" \
        '{phase:$phase, type:$type, summary:$summary, pr_number:($pr_number|tonumber? // $pr_number),
          repo:{owner:$owner, name:$repo}, snapshot:$snapshot}' > "$payload"
    orchestrator_enqueue_event "$WORKTREE" "$TASK_ID" "$type" "$summary" "$payload"
    rm -f "$payload"
}

# Fetch one consolidated snapshot via a single GraphQL call.
#
# Pulls everything in one round-trip: PR state, mergeable, mergeStateStatus,
# head/base refs, reviewDecision, reviews, conversation comments, review
# threads with their inline comments, and the latest commit's status-check
# rollup. This captures both "new review thread" and "new inline comment on
# existing thread" — `gh pr view --json` exposes neither (reviewThreads is
# GraphQL-only).
#
# Rate cost: ~10 points per call, well under the 5000/hr budget at 30s polls.
_GQL_QUERY='
query($owner:String!, $name:String!, $number:Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      state
      isDraft
      title
      mergeable
      mergeStateStatus
      reviewDecision
      headRefOid
      baseRefOid
      baseRefName
      reviews(first: 100) {
        nodes { id state submittedAt }
      }
      comments(first: 100) {
        nodes { id }
      }
      reviewThreads(first: 100) {
        nodes {
          id
          isResolved
          comments(first: 50) {
            nodes { id }
          }
        }
      }
      commits(last: 1) {
        nodes {
          commit {
            statusCheckRollup {
              contexts(first: 100) {
                nodes {
                  __typename
                  ... on CheckRun {
                    name
                    conclusion
                    status
                  }
                  ... on StatusContext {
                    context
                    state
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}'

fetch_snapshot() {
    gh api graphql \
        -F owner="$OWNER" \
        -F name="$REPO" \
        -F number="$PR_NUMBER" \
        -f query="$_GQL_QUERY" \
        2>/dev/null \
        | jq '.data.repository.pullRequest // empty'
}

# Read state file, falling back to "{}" if missing.
read_state() { [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo "{}"; }

# Diff snapshot vs prior state. Outputs zero or more transition summaries
# (one per line), each suitable for the supervisor.
diff_snapshot() {
    local prior="$1" cur="$2"
    # `-n` is critical: without it, jq waits for stdin documents (which never
    # arrive in the $() context) and the filter silently never runs,
    # swallowing every transition.
    jq -n -r --argjson prior "$prior" --argjson cur "$cur" '
        # Helpers — operate against the GraphQL response shape.
        def asArray: if . == null then [] else . end;

        # Status check rollup is nested under commits.nodes[0].commit. Each
        # context is either a CheckRun (name + conclusion/status) or a
        # StatusContext (context + state). Normalise to {name: conclusion}.
        def check_map(pr):
            ( pr.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [] )
            | map(
                if .__typename == "CheckRun" then
                    {(.name|tostring): (.conclusion // .status // "PENDING")}
                elif .__typename == "StatusContext" then
                    {(.context|tostring): (.state // "PENDING")}
                else empty end
              )
            | add // {};

        # Flatten all inline review-comment IDs across all threads.
        def inline_ids(pr):
            ( pr.reviewThreads.nodes // [] )
            | map(.comments.nodes // [])
            | flatten
            | map(.id)
            | sort;

        def thread_ids(pr):
            ( pr.reviewThreads.nodes // [] ) | map(.id) | sort;

        # shape() normalises EITHER a raw GraphQL pull-request response
        # (used for $cur) OR the persisted flat state from build_state
        # (used for $prior). The `// fallback` chains read the persisted
        # field first; if missing (raw GraphQL input), the right-hand side
        # computes from the GraphQL shape. Without this dual-path support,
        # the review/comment/thread/inline ids for $prior were always [],
        # so the diff against $cur made every existing review look "new"
        # on every poll — the Stamp re-emission bug.
        # (NOTE to editors: no apostrophes in this jq filter — the whole
        # thing is inside a bash single-quoted string and an apostrophe
        # closes the quote, causing bash to start parsing jq as shell.)
        def shape(p):
            {
              state: p.state,
              draft: p.isDraft,
              mergeable: p.mergeable,
              mss: p.mergeStateStatus,
              head: p.headRefOid,
              base: p.baseRefOid,
              decision: p.reviewDecision,
              checks: (p.checks // (p | check_map(.))),
              review_ids: (p.review_ids // ((p.reviews.nodes // []) | map(.id) | sort)),
              comment_ids: (p.comment_ids // ((p.comments.nodes // []) | map(.id) | sort)),
              thread_ids: (p.thread_ids // (p | thread_ids(.))),
              inline_ids: (p.inline_ids // (p | inline_ids(.)))
            };

        ($prior | shape(.)) as $A | ($cur | shape(.)) as $B |

        # Emit one line per detected transition.
        [
          if $B.state == "MERGED" and ($A.state // "") != "MERGED"
            then "PR \($cur.title) merged. Exit babysit and proceed to task completion."
            else empty end,
          if $B.state == "CLOSED" and ($A.state // "") != "CLOSED"
            then "PR closed without merge. Move task to blocked/."
            else empty end,
          if $A.draft == true and $B.draft == false
            then "draft → ready: full babysit behavior re-engages (Phase 4 human comments + Phase 5 readiness)."
            else empty end,
          if $B.mergeable == "CONFLICTING" and ($A.mergeable // "") != "CONFLICTING"
            then "mergeable=CONFLICTING (base may have advanced to \($B.base[0:7])). Run Phase 2 conflict resolution."
            else empty end,
          if $B.mss == "BEHIND" and ($A.mss // "") != "BEHIND"
            then "mergeStateStatus=BEHIND — base moved; rebase preemptively to dodge a hard conflict."
            else empty end,
          if $B.base != $A.base and $A.base != null and $B.mergeable != "CONFLICTING"
            then "base branch advanced: \($A.base[0:7]) → \($B.base[0:7]) (no conflicts so far)."
            else empty end,
          ( [ $B.checks | to_entries[] | select(.value == "FAILURE" or .value == "ACTION_REQUIRED")
              | select(($A.checks // {})[.key] != .value)
              | "CI check FAILED: \(.key). Run Phase 3 CI diagnosis." ] | .[] ),
          ( [ $B.checks | to_entries[] | select(.value == "SUCCESS")
              | select(($A.checks // {})[.key] != "SUCCESS" and ($A.checks // {})[.key] != null)
              | "CI check recovered: \(.key) is now SUCCESS." ] | .[] ),
          ( ($B.review_ids - $A.review_ids)
              | if length > 0 then "\(length) new review submission(s)." else empty end ),
          ( ($B.thread_ids - $A.thread_ids)
              | if length > 0 then "\(length) new review thread(s). Run Phase 4 comment triage." else empty end ),
          ( (($B.inline_ids - $A.inline_ids) | length) as $new_inline
            | (($B.thread_ids - $A.thread_ids) | length) as $new_threads
            | if $new_inline > 0 and $new_threads == 0
              then "\($new_inline) new inline comment(s) on existing thread(s). Run Phase 4 comment triage."
              else empty end ),
          ( ($B.comment_ids - $A.comment_ids)
              | if length > 0 then "\(length) new conversation comment(s)." else empty end ),
          if $B.decision == "APPROVED" and $A.decision != "APPROVED"
            then "review approved by humans."
            else empty end,
          if $B.decision == "CHANGES_REQUESTED" and $A.decision != "CHANGES_REQUESTED"
            then "changes requested. Phase 4 triage."
            else empty end
        ] | map(select(. != null)) | .[]
    '
}

# Build updated state JSON for persistence.
build_state() {
    local cur="$1"
    jq -n --argjson cur "$cur" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg pr "$PR_NUMBER" '
        def check_map(pr):
            (pr.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [])
            | map(
                if .__typename == "CheckRun" then
                    {(.name|tostring): (.conclusion // .status // "PENDING")}
                elif .__typename == "StatusContext" then
                    {(.context|tostring): (.state // "PENDING")}
                else empty end
              )
            | add // {};

        {
            pr_number: ($pr|tonumber? // $pr),
            state: $cur.state,
            isDraft: $cur.isDraft,
            mergeable: $cur.mergeable,
            mergeStateStatus: $cur.mergeStateStatus,
            headRefOid: $cur.headRefOid,
            baseRefOid: $cur.baseRefOid,
            baseRefName: $cur.baseRefName,
            reviewDecision: $cur.reviewDecision,
            checks: ($cur | check_map(.)),
            review_ids: (($cur.reviews.nodes // []) | map(.id) | sort),
            comment_ids: (($cur.comments.nodes // []) | map(.id) | sort),
            thread_ids: (($cur.reviewThreads.nodes // []) | map(.id) | sort),
            inline_ids: (($cur.reviewThreads.nodes // []) | map(.comments.nodes // []) | flatten | map(.id) | sort),
            last_polled_at: $ts
        }
    '
}

# --- main loop ---

cleanup() { log "exiting"; exit "${1:-0}"; }
trap 'cleanup 0' INT TERM

log "watching PR #$PR_NUMBER (interval=${POLL_INTERVAL}s, task=$TASK_ID)"

prior_state="$(read_state)"

while true; do
    snapshot="$(fetch_snapshot)" || { log "gh pr view failed; retrying in 60s"; sleep 60; continue; }

    transitions="$(diff_snapshot "$prior_state" "$snapshot" 2>/dev/null || true)"

    if [[ -n "$transitions" ]]; then
        log "transitions detected:"
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            log "  → $line"
            record_transition "$line" "$snapshot"
        done <<< "$transitions"
    fi

    build_state "$snapshot" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    prior_state="$(read_state)"

    # Terminal: exit on merged/closed.
    pr_state="$(jq -r .state <<<"$snapshot")"
    case "$pr_state" in
        MERGED) log "PR merged — exiting"; exit 0 ;;
        CLOSED) log "PR closed without merge — exiting"; exit 1 ;;
    esac

    sleep "$POLL_INTERVAL"
done
