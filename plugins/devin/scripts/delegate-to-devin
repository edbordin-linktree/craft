#!/usr/bin/env bash
#
# delegate-to-devin — Create a Devin session and record it for Craft events.
#
# Usage:
#   delegate-to-devin \
#     --prompt-file <path>.md \
#     --schema-file <path>.json \
#     --output <path>.md \
#     [--tag <tag>] \
#     [--repos repo1,repo2,...] \
#     [--acu-limit N] \
#     [--title "Short title"] \
#     [--task-id task-123] \
#     [--poll-interval SECONDS] \  # accepted for compatibility; no-op
#     [--poll-timeout SECONDS]     # accepted for compatibility; no-op
#
# Env:
#   DEVIN_API_KEY        — required
#   DEVIN_ORG_ID         — if set, uses v3 enterprise endpoints
#   DEVIN_API_BASE       — override (default: https://api.devin.ai)
#
# Stdout (on success): a single JSON pointer object.
# Exits non-zero on any failure with a human-readable stderr message.

set -euo pipefail

# --- defaults ---
PROMPT_FILE=""
SCHEMA_FILE=""
OUTPUT_FILE=""
TAG=""
REPOS=""
ACU_LIMIT="${DEVIN_ACU_LIMIT:-10}"
TITLE=""
TASK_ID_OVERRIDE=""
POLL_INTERVAL="${DEVIN_POLL_INTERVAL:-20}"
POLL_TIMEOUT="${DEVIN_POLL_TIMEOUT:-3600}"
API_BASE="${DEVIN_API_BASE:-https://api.devin.ai}"

# --- parse args ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --prompt-file)   PROMPT_FILE="$2"; shift 2 ;;
        --schema-file)   SCHEMA_FILE="$2"; shift 2 ;;
        --output)        OUTPUT_FILE="$2"; shift 2 ;;
        --tag)           TAG="$2"; shift 2 ;;
        --repos)         REPOS="$2"; shift 2 ;;
        --acu-limit)     ACU_LIMIT="$2"; shift 2 ;;
        --title)         TITLE="$2"; shift 2 ;;
        --task-id)       TASK_ID_OVERRIDE="$2"; shift 2 ;;
        --poll-interval) POLL_INTERVAL="$2"; shift 2 ;;
        --poll-timeout)  POLL_TIMEOUT="$2"; shift 2 ;;
        -h|--help)
            sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \?//'
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

# --- validate ---
die() { echo "delegate-to-devin: $*" >&2; exit 1; }

[[ -n "$PROMPT_FILE" ]] || die "--prompt-file is required"
[[ -f "$PROMPT_FILE" ]] || die "prompt file not found: $PROMPT_FILE"
[[ -n "$OUTPUT_FILE" ]] || die "--output is required"
[[ -n "${DEVIN_API_KEY:-}" ]] || die "DEVIN_API_KEY env var is required"
command -v jq >/dev/null   || die "jq is required (brew install jq)"
command -v curl >/dev/null || die "curl is required"

if [[ -n "$SCHEMA_FILE" ]]; then
    [[ -f "$SCHEMA_FILE" ]] || die "schema file not found: $SCHEMA_FILE"
fi

mkdir -p "$(dirname "$OUTPUT_FILE")"

# --- build the prompt ---
# Devin's structured_output convention: include the schema in the prompt and
# instruct Devin to keep structured_output updated.

PROMPT_BODY="$(cat "$PROMPT_FILE")"
if [[ -n "$SCHEMA_FILE" ]]; then
    SCHEMA_BODY="$(cat "$SCHEMA_FILE")"
    PROMPT_BODY="$PROMPT_BODY

---
Keep \`structured_output\` updated continuously as you work. Final
\`structured_output\` MUST match this JSON Schema exactly:

\`\`\`json
$SCHEMA_BODY
\`\`\`

Do not complete until structured_output is fully populated per the schema.
"
fi

# --- choose endpoint ---
if [[ -n "${DEVIN_ORG_ID:-}" ]]; then
    SESSIONS_URL="$API_BASE/v3/organizations/$DEVIN_ORG_ID/sessions"
    AUTH_HEADERS=(-H "Authorization: Bearer $DEVIN_API_KEY" -H "X-Org-Id: $DEVIN_ORG_ID")
else
    SESSIONS_URL="$API_BASE/v1/sessions"
    AUTH_HEADERS=(-H "Authorization: Bearer $DEVIN_API_KEY")
fi

# --- build create payload ---
if [[ -n "$SCHEMA_FILE" ]]; then
    PAYLOAD="$(jq -n \
        --arg prompt "$PROMPT_BODY" \
        --arg title "$TITLE" \
        --arg tag "$TAG" \
        --arg repos "$REPOS" \
        --argjson acu_limit "$ACU_LIMIT" \
        --slurpfile structured_output_schema "$SCHEMA_FILE" \
        '
        {
            prompt: $prompt,
            max_acu_limit: $acu_limit,
            structured_output_schema: $structured_output_schema[0]
        }
        + (if $title != "" then { title: $title } else {} end)
        + (if $tag != ""   then { tags: [$tag] }  else {} end)
        + (if $repos != "" then { repos: ($repos | split(",")) } else {} end)
        '
    )"
else
    PAYLOAD="$(jq -n \
        --arg prompt "$PROMPT_BODY" \
        --arg title "$TITLE" \
        --arg tag "$TAG" \
        --arg repos "$REPOS" \
        --argjson acu_limit "$ACU_LIMIT" \
        '
        {
            prompt: $prompt,
            max_acu_limit: $acu_limit
        }
        + (if $title != "" then { title: $title } else {} end)
        + (if $tag != ""   then { tags: [$tag] }  else {} end)
        + (if $repos != "" then { repos: ($repos | split(",")) } else {} end)
        '
    )"
fi

# --- create the session ---
echo "delegate-to-devin: creating session..." >&2
CREATE_RESP="$(curl -fsS -X POST "$SESSIONS_URL" \
    "${AUTH_HEADERS[@]}" \
    -H "Content-Type: application/json" \
    -d "$PAYLOAD")" || die "POST $SESSIONS_URL failed"

SESSION_ID="$(echo "$CREATE_RESP" | jq -r '.session_id // .id // empty')"
SESSION_URL="$(echo "$CREATE_RESP" | jq -r '.url // empty')"

[[ -n "$SESSION_ID" ]] || die "no session_id in create response: $CREATE_RESP"

if [[ -z "$SESSION_URL" ]]; then
    SESSION_URL="https://app.devin.ai/sessions/$SESSION_ID"
fi

echo "delegate-to-devin: session $SESSION_ID created — $SESSION_URL" >&2

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
# shellcheck source=bin/lib/task-runtime.sh
source "${CRAFT_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}/bin/lib/task-runtime.sh"

find_project_dir() {
    local d="${1:-$PWD}"
    while [[ "$d" != "/" ]]; do
        if [[ -f "$d/craft.conf" ]]; then
            echo "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    return 1
}

abs_path() {
    local path="$1" dir base
    dir="$(dirname "$path")"
    base="$(basename "$path")"
    mkdir -p "$dir"
    printf '%s/%s\n' "$(cd "$dir" && pwd -P)" "$base"
}

resolve_task_context() {
    local cwd="$1" task_id="$TASK_ID_OVERRIDE"
    if [[ -z "$task_id" ]]; then
        task_id="$(orchestrator_task_id_from_worktree "$cwd" 2>/dev/null || true)"
    fi
    [[ -n "$task_id" && "$task_id" != "." && "$task_id" != "/" ]] || return 1
    echo "$task_id"
}

open_devin_surface() {
    local cwd task_id output sid
    cwd="$(pwd -P)"
    task_id="$(resolve_task_context "$cwd" 2>/dev/null || true)"
    if [[ -z "$task_id" ]]; then
        echo "delegate-to-devin: no task id available; session URL: $SESSION_URL" >&2
        return 0
    fi
    output="$(orchestrator_surface_open "$cwd" "$task_id" devin-session \
        --url "$SESSION_URL" --label "devin" --owner devin --stage implement --url-match prefix 2>&1)" || {
        echo "delegate-to-devin: could not open cmux Devin surface; session URL: $SESSION_URL ($output)" >&2
        return 0
    }
    sid="$(printf '%s\n' "$output" | grep -oE 'surface:[0-9]+' | head -1)"
    [[ -n "$sid" ]] && echo "delegate-to-devin: opened Devin surface $sid" >&2
}

open_devin_surface

STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

TASK_ID="$(resolve_task_context "$(pwd -P)" 2>/dev/null || true)"
PROJECT_DIR="$(find_project_dir "$(pwd -P)" 2>/dev/null || true)"
OUTPUT_FILE="$(abs_path "$OUTPUT_FILE")"
SESSION_RECORD=""
if [[ -n "$TASK_ID" && -n "$PROJECT_DIR" ]]; then
    SESSION_DIR="$PROJECT_DIR/tasks/$TASK_ID/.orchestrator/devin/sessions"
    mkdir -p "$SESSION_DIR"
    SESSION_RECORD="$SESSION_DIR/$SESSION_ID.json"
    jq -n \
        --arg task_id "$TASK_ID" \
        --arg session_id "$SESSION_ID" \
        --arg url "$SESSION_URL" \
        --arg output_path "$OUTPUT_FILE" \
        --arg started_at "$STARTED_AT" \
        --arg title "$TITLE" \
        --arg tag "$TAG" \
        --arg api_base "$API_BASE" \
        '{
            task_id: $task_id,
            session_id: $session_id,
            url: $url,
            output_path: $output_path,
            started_at: $started_at,
            title: $title,
            tag: $tag,
            api_base: $api_base,
            status: "pending"
        }' > "$SESSION_RECORD"
fi

# --- print pointer JSON ---
jq -n \
    --arg session_id "$SESSION_ID" \
    --arg url "$SESSION_URL" \
    --arg output_path "$OUTPUT_FILE" \
    --arg status "pending" \
    --arg started_at "$STARTED_AT" \
    --arg session_record "$SESSION_RECORD" \
    --arg task_id "$TASK_ID" \
    '{
        session_id: $session_id,
        url: $url,
        output_path: $output_path,
        status: $status,
        started_at: $started_at,
        session_record: $session_record,
        task_id: $task_id,
        event_type: "devin.session_settled"
    }'
