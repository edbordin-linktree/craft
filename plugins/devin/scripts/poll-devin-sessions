#!/usr/bin/env bash
#
# poll-devin-sessions — Check pending Devin sessions and publish Craft events.

set -euo pipefail

PROJECT_DIR=""
API_BASE="${DEVIN_API_BASE:-https://api.devin.ai}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --project-dir) PROJECT_DIR="$2"; shift 2 ;;
        -h|--help)
            sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \?//'
            exit 0
            ;;
        *) echo "poll-devin-sessions: unknown arg: $1" >&2; exit 2 ;;
    esac
done

die() { echo "poll-devin-sessions: $*" >&2; exit 1; }

[[ -n "$PROJECT_DIR" ]] || die "--project-dir is required"
[[ -d "$PROJECT_DIR" ]] || die "project dir not found: $PROJECT_DIR"
[[ -n "${DEVIN_API_KEY:-}" ]] || exit 0
command -v jq >/dev/null || die "jq is required"
command -v curl >/dev/null || die "curl is required"

PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"
CRAFT_ROOT="${CRAFT_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd -P)}"

auth_headers() {
    if [[ -n "${DEVIN_ORG_ID:-}" ]]; then
        printf '%s\0%s\0%s\0%s\0' \
            -H "Authorization: Bearer $DEVIN_API_KEY" \
            -H "X-Org-Id: $DEVIN_ORG_ID"
    else
        printf '%s\0%s\0' -H "Authorization: Bearer $DEVIN_API_KEY"
    fi
}

session_get_url() {
    local session_id="$1" base="${2:-$API_BASE}"
    if [[ -n "${DEVIN_ORG_ID:-}" ]]; then
        printf '%s/v3/organizations/%s/sessions/%s\n' "$base" "$DEVIN_ORG_ID" "$session_id"
    else
        printf '%s/v1/sessions/%s\n' "$base" "$session_id"
    fi
}

render_structured_output() {
    local structured="$1" output_file="$2" session_id="$3" session_url="$4" started_at="$5" settled_at="$6" final_status="$7"
    local has_markdown summary
    mkdir -p "$(dirname "$output_file")"
    has_markdown="$(jq -r 'if type=="object" and has("markdown") then "yes" else "no" end' <<< "$structured")"
    summary="$(jq -r '
        if type=="object" then
            (.summary // .Summary // .description // .description_short // empty)
        else
            empty
        end' <<< "$structured" | head -c 280)"
    [[ -n "$summary" ]] || summary="(no summary field in structured_output)"

    if [[ "$has_markdown" == "yes" ]]; then
        jq -r '.markdown' <<< "$structured" > "$output_file"
    else
        {
            echo "<!--"
            echo "Generated by delegate-to-devin"
            echo "session_id: $session_id"
            echo "url: $session_url"
            echo "started_at: $started_at"
            echo "settled_at: $settled_at"
            echo "-->"
            echo
            echo "# Devin output — session $session_id"
            echo
            if [[ -n "$summary" && "$summary" != "(no summary field in structured_output)" ]]; then
                echo "**Summary:** $summary"
                echo
            fi
            echo "## structured_output"
            echo
            echo '```json'
            jq . <<< "$structured"
            echo '```'
            echo
            echo "## Session"
            echo
            echo "- URL: $session_url"
            echo "- Status: $final_status"
        } > "$output_file"
    fi
    printf '%s\n' "$summary"
}

publish_event() {
    local task_id="$1" type="$2" summary="$3" payload="$4"
    (
        cd "$PROJECT_DIR" || exit 1
        CRAFT_ROOT="$CRAFT_ROOT" "$CRAFT_ROOT/bin/craft" event enqueue "$task_id" \
            --type "$type" --summary "$summary" --json "$payload" --publisher devin >/dev/null
    )
}

process_session_file() {
    local file="$1" status session_id session_url output_file started_at api_base get_url response final_status structured settled_at summary payload tmp
    status="$(jq -r '.status // empty' "$file")"
    [[ "$status" == "pending" ]] || return 0
    session_id="$(jq -r '.session_id // empty' "$file")"
    [[ -n "$session_id" ]] || return 0
    session_url="$(jq -r '.url // empty' "$file")"
    output_file="$(jq -r '.output_path // empty' "$file")"
    started_at="$(jq -r '.started_at // empty' "$file")"
    api_base="$(jq -r '.api_base // empty' "$file")"
    [[ -n "$api_base" ]] || api_base="$API_BASE"
    get_url="$(session_get_url "$session_id" "$api_base")"

    local headers=()
    while IFS= read -r -d '' item; do headers+=("$item"); done < <(auth_headers)
    response="$(curl -fsS "$get_url" "${headers[@]}")" || return 0
    final_status="$(jq -r '.status_enum // .status // .status_detail // empty' <<< "$response")"

    case "$final_status" in
        completed|finished|done|stopped|succeeded|exit|blocked) ;;
        failed|errored|cancelled|canceled) ;;
        ""|working|running|claimed|pending|active|in_progress) return 0 ;;
        *) return 0 ;;
    esac

    settled_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    structured="$(jq '.structured_output // null' <<< "$response")"
    tmp="$(mktemp)"
    if [[ "$structured" != "null" && -n "$structured" && "$final_status" != "failed" && "$final_status" != "errored" && "$final_status" != "cancelled" && "$final_status" != "canceled" ]]; then
        summary="$(render_structured_output "$structured" "$output_file" "$session_id" "$session_url" "$started_at" "$settled_at" "$final_status")"
        jq --arg status "$final_status" --arg settled_at "$settled_at" --arg summary "$summary" \
            '.status = "settled" | .final_status = $status | .settled_at = $settled_at | .summary = $summary' "$file" > "$tmp"
        mv "$tmp" "$file"
        payload="$(mktemp)"
        jq -n \
            --arg session_id "$session_id" \
            --arg url "$session_url" \
            --arg output_path "$output_file" \
            --arg status "$final_status" \
            --arg started_at "$started_at" \
            --arg settled_at "$settled_at" \
            --arg summary "$summary" \
            '{session_id:$session_id,url:$url,output_path:$output_path,status:$status,started_at:$started_at,settled_at:$settled_at,summary:$summary}' > "$payload"
        publish_event "$(jq -r '.task_id' "$file")" devin.session_settled "Devin session settled: $summary" "$payload"
        rm -f "$payload"
    else
        jq --arg status "$final_status" --arg settled_at "$settled_at" \
            '.status = "failed" | .final_status = $status | .settled_at = $settled_at' "$file" > "$tmp"
        mv "$tmp" "$file"
        payload="$(mktemp)"
        jq -n \
            --arg session_id "$session_id" \
            --arg url "$session_url" \
            --arg status "$final_status" \
            --arg settled_at "$settled_at" \
            '{session_id:$session_id,url:$url,status:$status,settled_at:$settled_at}' > "$payload"
        publish_event "$(jq -r '.task_id' "$file")" devin.session_failed "Devin session failed: $final_status" "$payload"
        rm -f "$payload"
    fi
}

while IFS= read -r file; do
    process_session_file "$file"
done < <(find "$PROJECT_DIR/tasks" -path '*/.orchestrator/devin/sessions/*.json' -type f 2>/dev/null | sort)
