#!/usr/bin/env bash
#
# bk-status-server — Exec the Buildkite status web server.
#
# Intended to be launched by bin/run-bg from a task worktree.

set -uo pipefail

PORT="${BK_STATUS_PORT:-27435}"
HOST="${BK_STATUS_HOST:-127.0.0.1}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
CRAFT_HOME="${CRAFT_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}"
SERVER_DIR="$CRAFT_HOME/plugins/buildkite-status/bk-status"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --port) PORT="$2"; shift 2 ;;
        --host) HOST="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "bk-status-server: unknown arg: $1" >&2; exit 2 ;;
    esac
done

[[ -f "$SERVER_DIR/server.tsx" ]] || { echo "bk-status-server: $SERVER_DIR/server.tsx missing" >&2; exit 1; }
cd "$SERVER_DIR" || exit 1
exec bun server.tsx --port "$PORT" --host "$HOST"
