#!/usr/bin/env bash
#
# start-discoverer — Queue a normal Craft discovery workflow task.
#
# This helper is intentionally not a mux/cmux launcher. Discovery runs through
# the same orchestrator path as any other task, using `workflow: discovery` and
# optional `DISCOVERY_AGENT` / `DISCOVERY_AGENT_MODEL` project config.
#
# Usage:
#   start-discoverer <topic-slug> <one-line-topic> [extra prompt lines...]
#
# Output:
#   start-discoverer.task=<task-id>
#   start-discoverer.file=<queue/approved/task-id.md>
#   start-discoverer.workflow=discovery

set -uo pipefail

if [[ ${BASH_VERSINFO[0]:-0} -lt 4 ]]; then
    echo "start-discoverer requires bash 4+" >&2
    exit 1
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//'
    exit 0
fi

[[ $# -ge 2 ]] || {
    echo "Usage: start-discoverer <topic-slug> <one-line-topic> [extra prompt text...]" >&2
    exit 2
}

TOPIC_SLUG="$1"
shift
TOPIC="$1"
shift
EXTRA="${*:-}"

if [[ ! "$TOPIC_SLUG" =~ ^[a-z0-9][a-z0-9-]*[a-z0-9]$ && ! "$TOPIC_SLUG" =~ ^[a-z0-9]$ ]]; then
    echo "start-discoverer: topic slug must be kebab-case alphanumerics" >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
CRAFT_HOME="${CRAFT_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd -P)}"

# shellcheck source=bin/lib/queue.sh
source "$CRAFT_HOME/bin/lib/queue.sh"
# shellcheck source=bin/lib/runtime.sh
source "$CRAFT_HOME/bin/lib/runtime.sh"
# shellcheck source=bin/lib/providers.sh
source "$CRAFT_HOME/bin/lib/providers.sh"

PROJECT_DIR="${PROJECT_DIR:-$(pwd -P)}"
if [[ ! -f "$PROJECT_DIR/craft.conf" ]]; then
    if resolved="$(runtime_project_dir "$PROJECT_DIR" 2>/dev/null)"; then
        PROJECT_DIR="$resolved"
    else
        echo "start-discoverer: not inside a Craft project (no craft.conf found)" >&2
        exit 1
    fi
fi

load_provider_config "$PROJECT_DIR"

mkdir -p "$PROJECT_DIR/queue/approved"

yaml_quote() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}

next_task_id() {
    local max=0 f base num
    shopt -s nullglob
    for f in "$PROJECT_DIR"/queue/*/task-*.md; do
        base="$(basename "$f" .md)"
        num="${base#task-}"
        if [[ "$num" =~ ^[0-9]+$ ]] && (( 10#$num > max )); then
            max=$((10#$num))
        fi
    done
    shopt -u nullglob
    printf 'task-%03d' $((max + 1))
}

TASK_ID="$(next_task_id)"
TASK_FILE="$PROJECT_DIR/queue/approved/$TASK_ID.md"
DISCOVERY_AGENT="${DISCOVERY_AGENT:-${ARCHITECT_AGENT:-}}"
DISCOVERY_AGENT_MODEL="${DISCOVERY_AGENT_MODEL:-}"

{
    echo "---"
    echo "id: $TASK_ID"
    echo "type: discovery"
    echo "status: approved"
    echo "workflow: discovery"
    [[ -n "$DISCOVERY_AGENT" ]] && echo "agent: $(yaml_quote "$DISCOVERY_AGENT")"
    [[ -n "$DISCOVERY_AGENT_MODEL" ]] && echo "agent_model: $(yaml_quote "$DISCOVERY_AGENT_MODEL")"
    echo "depends_on: []"
    echo "repos: []"
    echo "branch: $(yaml_quote "discovery/$TOPIC_SLUG")"
    echo "workflow_options:"
    echo "  topic_slug: $(yaml_quote "$TOPIC_SLUG")"
    echo "  topic: $(yaml_quote "$TOPIC")"
    echo "  framing: $(yaml_quote "$EXTRA")"
    echo "qa:"
    echo "  unit_tests: false"
    echo "  integration_tests: false"
    echo "---"
    echo
    echo "## Summary"
    echo
    echo "$TOPIC"
    if [[ -n "$EXTRA" ]]; then
        echo
        echo "$EXTRA"
    fi
    echo
    echo "## Work Log"
} > "$TASK_FILE"

printf 'start-discoverer.task=%s\n' "$TASK_ID"
printf 'start-discoverer.file=%s\n' "${TASK_FILE#"$PROJECT_DIR/"}"
printf 'start-discoverer.workflow=discovery\n'
