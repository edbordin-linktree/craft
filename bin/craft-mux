#!/usr/bin/env bash
#
# craft-mux — Skill-facing wrapper for craft's multiplexer abstraction.
#
# Lets skills spawn / send-to / check / kill named panes in the current craft
# project's multiplexer session, without needing to know whether it's tmux or
# cmux underneath.
#
# Usage:
#   craft-mux spawn <name> <cwd> <cmd...>      Create a named pane running cmd
#   craft-mux send  <name> <text...>            Send text + Enter to named pane
#   craft-mux exists <name>                     Exit 0 if pane exists, 1 if not
#   craft-mux kill  <name>                      Remove a named pane
#   craft-mux session                           Print the resolved session name
#   craft-mux send-task <task-id> <text...>     Send text to a task's agent pane
#   craft-mux open <task-id> <surface-id> ...   Open/reuse a task web surface
#   craft-mux focus <task-id> <surface-id>      Focus a registered task surface
#   craft-mux workspace-state <task-id> [surface-id]
#                                                 Print task workspace/surface JSON
#   craft-mux close <task-id> <surface-id>      Close a registered task surface
#   craft-mux status <task-id> <state> ...      Set a visible task status banner
#
# Auto-detects the craft project by walking up from $PWD looking for craft.conf.

set -uo pipefail

# --- Locate the craft project ---
_find_project_dir() {
    local d="${PWD}"
    while [[ "$d" != "/" ]]; do
        if [[ -f "$d/craft.conf" ]]; then echo "$d"; return 0; fi
        d="$(dirname "$d")"
    done
    return 1
}

PROJECT_DIR="$(_find_project_dir)" || {
    echo "craft-mux: not inside a craft project (no craft.conf found walking up from $PWD)" >&2
    exit 2
}
export PROJECT_DIR

PROJECT_NAME="$(basename "$PROJECT_DIR")"

# --- Source craft's mux abstraction ---
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/providers.sh"
load_provider_config "$PROJECT_DIR"   # sets MULTIPLEXER
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/runtime.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/mux.sh"

# Session name follows the same convention used by each backend's ensure_session.
case "$MULTIPLEXER" in
    tmux) SESSION="${TMUX_SESSION:-craft}-${PROJECT_NAME}" ;;
    cmux) SESSION="${CMUX_PREFIX:-craft}-${PROJECT_NAME}" ;;
    *)
        echo "craft-mux: unknown MULTIPLEXER='$MULTIPLEXER'" >&2
        exit 2
        ;;
esac

OVERRIDE_SESSION=""
if [[ "${1:-}" == "--session" ]]; then
    OVERRIDE_SESSION="${2:-}"
    [[ -n "$OVERRIDE_SESSION" ]] || { echo "craft-mux: --session requires a value" >&2; exit 2; }
    shift 2
fi
[[ -n "$OVERRIDE_SESSION" ]] && SESSION="$OVERRIDE_SESSION"

# --- Dispatch ---
cmd="${1:-}"
[[ -n "$cmd" ]] || { echo "Usage: $0 [--session SESSION] spawn|send|exists|kill|session|send-task|open|focus|workspace-state|close|status ..." >&2; exit 2; }
shift

case "$cmd" in
    spawn)
        # craft-mux spawn <name> <cwd> <cmd...>
        name="${1:?name required}"; shift
        cwd="${1:?cwd required}"; shift
        full_cmd="$*"
        [[ -n "$full_cmd" ]] || { echo "craft-mux: cmd required" >&2; exit 2; }
        mux_spawn_named_pane "$SESSION" "$name" "$cwd" "$full_cmd"
        ;;
    send)
        # craft-mux send <name> <text...>
        name="${1:?name required}"; shift
        text="$*"
        [[ -n "$text" ]] || { echo "craft-mux: text required" >&2; exit 2; }
        mux_send_to_pane "$SESSION" "$name" "$text"
        ;;
    exists)
        name="${1:?name required}"
        mux_pane_exists "$SESSION" "$name"
        ;;
    kill)
        name="${1:?name required}"
        mux_kill_named_pane "$SESSION" "$name"
        ;;
    session)
        echo "$SESSION"
        ;;
    send-task)
        task_id="${1:?task id required}"; shift
        text="$*"
        [[ -n "$text" ]] || { echo "craft-mux: text required" >&2; exit 2; }
        case "$MULTIPLEXER" in
            tmux) task_session="$SESSION" ;;
            cmux) task_session="${CMUX_PREFIX:-craft}-${PROJECT_NAME}-${task_id}" ;;
        esac
        pane_name="$task_id"
        mux_send_to_pane "$task_session" "$pane_name" "$text"
        ;;
    open)
        task_id="${1:?task id required}"; shift
        surface_id="${1:?surface id required}"; shift
        mux_surface_open "$PROJECT_DIR" "$task_id" "$surface_id" "$@"
        ;;
    focus)
        task_id="${1:?task id required}"; shift
        surface_id="${1:?surface id required}"
        attach_first=false
        shift || true
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --attach) attach_first=true; shift ;;
                *) echo "craft-mux focus: unknown arg: $1" >&2; exit 2 ;;
            esac
        done
        mux_surface_focus "$PROJECT_DIR" "$task_id" "$surface_id" "$attach_first"
        ;;
    workspace-state)
        task_id="${1:?task id required}"; shift
        surface_id="${1:-agent}"
        mux_task_workspace_state "$PROJECT_DIR" "$task_id" "$surface_id"
        ;;
    close)
        task_id="${1:?task id required}"; shift
        surface_id="${1:?surface id required}"
        mux_surface_close "$PROJECT_DIR" "$task_id" "$surface_id"
        ;;
    status)
        task_id="${1:?task id required}"; shift
        status_text="${1:?status required}"; shift
        icon="circle"
        color="#6b7280"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --icon) icon="${2:-}"; shift 2 ;;
                --color) color="${2:-}"; shift 2 ;;
                *) echo "craft-mux status: unknown arg: $1" >&2; exit 2 ;;
            esac
        done
        mux_task_status_set "$PROJECT_NAME" "$task_id" "$status_text" "$icon" "$color"
        ;;
    *)
        echo "craft-mux: unknown subcommand '$cmd'" >&2
        echo "Usage: $0 [--session SESSION] spawn|send|exists|kill|session|send-task|open|focus|workspace-state|close|status ..." >&2
        exit 2
        ;;
esac
