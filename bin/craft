#!/usr/bin/env bash
# craft — project orchestrator CLI

set -euo pipefail

# craft uses bash 4+ features (associative arrays, etc.). macOS ships bash 3.2
# by default; force-fail with a clear message rather than producing confusing
# `declare: -A: invalid option` errors deep in the call stack.
if [[ ${BASH_VERSINFO[0]:-0} -lt 4 ]]; then
    echo "craft requires bash 4+ (you have ${BASH_VERSION:-unknown}). On macOS: 'brew install bash' then ensure /opt/homebrew/bin (or /usr/local/bin) is earlier on PATH than /bin." >&2
    exit 1
fi

# Resolve CRAFT_ROOT to the repo root, following symlinks
_resolve_script() {
    local src="$1"
    while [[ -L "$src" ]]; do
        local dir
        dir="$(cd "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    echo "$src"
}
CRAFT_ROOT="${CRAFT_ROOT:-$(cd "$(dirname "$(_resolve_script "$0")")/.." && pwd)}"

# Projects directory — defaults to $CRAFT_ROOT/projects but can be overridden
# (useful for Homebrew installs where CRAFT_ROOT is read-only)
CRAFT_PROJECTS="${CRAFT_PROJECTS:-$CRAFT_ROOT/projects}"
export CRAFT_ROOT CRAFT_PROJECTS

# shellcheck source=bin/lib/plugins.sh
source "$CRAFT_ROOT/bin/lib/plugins.sh"
# shellcheck source=bin/lib/runtime.sh
source "$CRAFT_ROOT/bin/lib/runtime.sh"

# Version
if [[ -f "$CRAFT_ROOT/VERSION" ]]; then
    CRAFT_VERSION="$(cat "$CRAFT_ROOT/VERSION")"
else
    CRAFT_VERSION="dev"
fi

usage() {
    cat << USAGE
craft — project orchestrator CLI (v${CRAFT_VERSION})

Usage:
  craft init <project-name>          Scaffold a new project
  craft <project-name> [options]     Start the orchestrator
  craft projects                     List all projects
  craft status <project-name>        Show project state at a glance
  craft metrics <project-name>       Show task performance metrics
  craft config <project> [key] [val] Read or set project config
  craft plugin <subcommand>          Manage plugins
  craft task state set ...           Move a task through queue/runtime state
  craft task wait-team <task-id>     Mark a task as waiting on team
  craft task unwait-team <task-id>   Clear waiting-on-team marker
  craft task promote-draft <task-id> Promote a draft task to pending
  craft task stage <subcommand>      Get or mutate a task workflow stage
  craft workflow render [task]       Render assembled workflow prompt
  craft event <subcommand>           Manage a task's pending event queue
  craft surface <subcommand>         Manage task web surfaces
  craft doctor                       Check dependencies
  craft --version                    Show version

Run 'craft <command> --help' for details on any command.

Quick start:
  craft init my-project              Create a project
  craft my-project                   Start the orchestrator
USAGE
}

_cmd_project_dir() {
    runtime_project_dir "${PWD}" || {
        echo "craft: not inside a project (no craft.conf found)" >&2
        exit 2
    }
}

_require_reason() {
    local reason="$1"
    [[ -n "$reason" ]] || {
        echo "craft: --reason is required" >&2
        exit 2
    }
}

_task_file_from_arg() {
    local project_dir="$1" arg="${2:-}"
    local queue_dir="$project_dir/queue" task_id candidate dir

    if [[ -z "$arg" ]]; then
        next_ready_task "$queue_dir"
        return
    fi

    if [[ -f "$arg" ]]; then
        (cd "$(dirname "$arg")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$arg")")
        return
    fi

    candidate="$project_dir/$arg"
    if [[ -f "$candidate" ]]; then
        (cd "$(dirname "$candidate")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$candidate")")
        return
    fi

    task_id="${arg%.md}"
    if [[ "$task_id" == task-* ]]; then
        runtime_task_file "$project_dir" "$task_id"
        return
    fi

    for dir in "$queue_dir"/*; do
        [[ -d "$dir" ]] || continue
        candidate="$dir/$arg"
        [[ -f "$candidate" ]] && { printf '%s\n' "$candidate"; return; }
    done
    return 1
}

cmd_task() {
    local group="${1:-}"
    shift || true
    case "$group" in
        promote-draft)
            local task_id="${1:?task id required}"
            local project_dir
            project_dir="$(_cmd_project_dir)"
            promote_draft_task "$project_dir/queue" "$task_id" >/dev/null
            ;;
        wait-team)
            local task_id="${1:?task id required}" reason="team"
            shift || true
            local project_dir task_file
            project_dir="$(_cmd_project_dir)"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --reason) reason="${2:-team}"; shift 2 ;;
                    *) echo "craft task wait-team: unknown arg: $1" >&2; exit 2 ;;
                esac
            done
            task_file="$(runtime_task_file "$project_dir" "$task_id")" || { echo "task_not_found: $task_id" >&2; exit 1; }
            runtime_set_task_field "$task_file" waiting_on team
            runtime_set_task_field "$task_file" waiting_reason "$reason"
            runtime_append_work_log "$task_file" "Waiting On Team" "$reason"
            ;;
        unwait-team)
            local task_id="${1:?task id required}"
            local project_dir task_file
            project_dir="$(_cmd_project_dir)"
            task_file="$(runtime_task_file "$project_dir" "$task_id")" || { echo "task_not_found: $task_id" >&2; exit 1; }
            runtime_set_task_field "$task_file" waiting_on ""
            runtime_set_task_field "$task_file" waiting_reason ""
            runtime_append_work_log "$task_file" "Waiting On Team Cleared"
            ;;
        state)
            local subcmd="${1:-}"
            shift || true
            local project_dir
            project_dir="$(_cmd_project_dir)"
            case "$subcmd" in
                set)
                    local task_id="${1:?task id required}" status="${2:?queue state required}" reason="" stage="" log_title="" log_body=""
                    local fields=()
                    shift 2 || true
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --reason) reason="${2:-}"; shift 2 ;;
                            --stage) stage="${2:-}"; shift 2 ;;
                            --set) fields+=("${2:-}"); shift 2 ;;
                            --log) log_title="${2:-}"; shift 2 ;;
                            --log-body) log_body="${2:-}"; shift 2 ;;
                            *) echo "craft task state set: unknown arg: $1" >&2; exit 2 ;;
                        esac
                    done
                    _require_reason "$reason"
                    runtime_task_state_set "$project_dir" "$task_id" "$status" "$reason" "$stage" "$log_title" "$log_body" "${fields[@]}" >/dev/null
                    ;;
                *)
                    echo "Usage: craft task state set <task-id> <queue-state> --reason <text> [--stage <stage>] [--set key=value] [--log <title>] [--log-body <text>]" >&2
                    exit 2
                    ;;
            esac
            ;;
        signal)
            local task_id="${1:?task id required}" type="${2:?event type required}" reason="" publisher="operator"
            shift 2 || true
            local project_dir payload
            project_dir="$(_cmd_project_dir)"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --reason) reason="${2:-}"; shift 2 ;;
                    --publisher) publisher="${2:-}"; shift 2 ;;
                    *) echo "craft task signal: unknown arg: $1" >&2; exit 2 ;;
                esac
            done
            _require_reason "$reason"
            payload="$(mktemp)"
            jq -n --arg type "$type" --arg reason "$reason" '{type:$type, reason:$reason}' > "$payload"
            runtime_event_enqueue "$project_dir" "$task_id" "$type" "$reason" "$payload" "$publisher" >/dev/null
            rm -f "$payload"
            ;;
        stage)
            local subcmd="${1:-}"
            shift || true
            local project_dir
            project_dir="$(_cmd_project_dir)"
            case "$subcmd" in
                get)
                    local task_id="${1:?task id required}"
                    local task_file
                    task_file="$(runtime_task_file "$project_dir" "$task_id")" || { echo "task_not_found: $task_id" >&2; exit 1; }
                    runtime_task_stage "$task_file"
                    ;;
                set)
                    local task_id="${1:?task id required}" stage="${2:?stage required}" reason=""
                    shift 2 || true
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --reason) reason="${2:-}"; shift 2 ;;
                            *) echo "craft task stage set: unknown arg: $1" >&2; exit 2 ;;
                        esac
                    done
                    _require_reason "$reason"
                    runtime_stage_set "$project_dir" "$task_id" "$stage" "$reason" active >/dev/null
                    ;;
                advance)
                    local task_id="${1:?task id required}" reason=""
                    shift || true
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --reason) reason="${2:-}"; shift 2 ;;
                            *) echo "craft task stage advance: unknown arg: $1" >&2; exit 2 ;;
                        esac
                    done
                    _require_reason "$reason"
                    runtime_stage_advance "$project_dir" "$task_id" "$reason" >/dev/null
                    ;;
                block)
                    local task_id="${1:?task id required}" reason=""
                    shift || true
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --reason) reason="${2:-}"; shift 2 ;;
                            *) echo "craft task stage block: unknown arg: $1" >&2; exit 2 ;;
                        esac
                    done
                    _require_reason "$reason"
                    runtime_stage_set "$project_dir" "$task_id" blocked "$reason" blocked >/dev/null
                    ;;
                complete)
                    local task_id="${1:?task id required}" reason="completed"
                    shift || true
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --reason) reason="${2:-}"; shift 2 ;;
                            *) echo "craft task stage complete: unknown arg: $1" >&2; exit 2 ;;
                        esac
                    done
                    runtime_stage_set "$project_dir" "$task_id" complete "$reason" complete >/dev/null
                    ;;
                *)
                    echo "Usage: craft task stage get|set|advance|block|complete ..." >&2
                    exit 2
                    ;;
            esac
            ;;
        *)
            echo "Usage: craft task promote-draft <task-id> | wait-team <task-id> | unwait-team <task-id> | state <subcommand> | stage <subcommand>" >&2
            exit 2
            ;;
    esac
}

cmd_event() {
    local subcmd="${1:-}"
    shift || true
    local project_dir
    project_dir="$(_cmd_project_dir)"
    case "$subcmd" in
        enqueue)
            local task_id="${1:?task id required}" type="" summary="" payload="" publisher="cli"
            shift || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --type) type="${2:-}"; shift 2 ;;
                    --summary) summary="${2:-}"; shift 2 ;;
                    --json) payload="${2:-}"; shift 2 ;;
                    --publisher) publisher="${2:-}"; shift 2 ;;
                    *) echo "craft event enqueue: unknown arg: $1" >&2; exit 2 ;;
                esac
            done
            [[ -n "$type" && -n "$summary" && -n "$payload" ]] || {
                echo "Usage: craft event enqueue <task-id> --type <type> --summary <text> --json <payload-file> [--publisher <name>]" >&2
                exit 2
            }
            runtime_event_enqueue "$project_dir" "$task_id" "$type" "$summary" "$payload" "$publisher"
            ;;
        counts)
            runtime_event_counts "$project_dir" "${1:?task id required}"
            ;;
        take)
            local task_id="${1:?task id required}" type="" limit=""
            shift || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --type) type="${2:-}"; shift 2 ;;
                    --limit) limit="${2:-}"; shift 2 ;;
                    *) echo "craft event take: unknown arg: $1" >&2; exit 2 ;;
                esac
            done
            runtime_event_take "$project_dir" "$task_id" "$type" "$limit"
            ;;
        *)
            echo "Usage: craft event enqueue|counts|take ..." >&2
            exit 2
            ;;
    esac
}

cmd_workflow() {
    local subcmd="${1:-}"
    shift || true
    local project_dir
    project_dir="$(_cmd_project_dir)"
    case "$subcmd" in
        render)
            local task_arg="${1:-}" task_file filename
            task_file="$(_task_file_from_arg "$project_dir" "$task_arg")" || {
                echo "task_not_found: ${task_arg:-next ready task}" >&2
                exit 1
            }
            filename="$(basename "$task_file")"
            workflow_render_prompt "$project_dir" "$task_file" "$filename"
            ;;
        *)
            echo "Usage: craft workflow render [task-id|task-file]" >&2
            exit 2
            ;;
    esac
}

cmd_surface() {
    local subcmd="${1:-}"
    shift || true
    local project_dir
    project_dir="$(_cmd_project_dir)"
    # Surface operations are implemented by craft-mux so provider differences
    # stay behind the mux abstraction.
    "$CRAFT_ROOT/bin/craft-mux" "$subcmd" "$@"
}

# Portable sed -i wrapper (macOS vs GNU)
# Uses -E for extended regex so ? and + work consistently
_sed_i() {
    if sed --version 2>/dev/null | grep -q GNU; then
        sed -i -E "$@"
    else
        sed -i "" -E "$@"
    fi
}

cmd_config() {
    if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
        cat << 'HELP'
craft config — Read or set project configuration

Usage:
  craft config <project>              Show all config values
  craft config <project> <key>        Get a single value
  craft config <project> <key> <val>  Set a value

Keys:
  DEFAULT_AGENT    Agent CLI for tasks (default: claude)
  ARCHITECT_AGENT  Agent CLI for architect window (default: claude)
  *_MODEL          Optional model flag for matching agent, e.g. CLAUDE_MODEL=opus
  MULTIPLEXER      Terminal multiplexer: tmux (default) or cmux
  AGENT_TIMEOUT    Max seconds per task before auto-block (default: none)
  OPERATOR_NAME    Your name, used in prompts
  GITHUB_REVIEWER  GitHub username for PR reviews
  BRANCH_PREFIX    Prepended to branch names (e.g. "sls/")
  PLUGINS          Comma-separated enabled plugins
  DASHBOARD_CMD    Optional cmux web dashboard entrypoint command

Examples:
  craft config my-project
  craft config my-project DEFAULT_AGENT
  craft config my-project DEFAULT_AGENT codex
  craft config my-project MULTIPLEXER cmux
  craft config my-project BRANCH_PREFIX "sls/"
HELP
        exit 0
    fi

    local project_name="${1:-}"
    if [[ -z "$project_name" ]]; then
        echo "Usage: craft config <project-name> [key] [value]"
        echo "Run 'craft config --help' for details."
        exit 1
    fi

    local conf="$CRAFT_PROJECTS/$project_name/craft.conf"
    if [[ ! -f "$conf" ]]; then
        echo "Project not found: $CRAFT_PROJECTS/$project_name"
        exit 1
    fi

    local key="${2:-}"
    local value="${3:-}"

    if [[ -z "$key" ]]; then
        echo "Config for $project_name ($conf):"
        grep -v '^#' "$conf" | grep -v '^[[:space:]]*$'
        return
    fi

    if [[ -z "$value" ]]; then
        grep "^${key}=" "$conf" | sed "s/^${key}=//"
        return
    fi

    if grep -q "^${key}=" "$conf" || grep -q "^# ${key}=" "$conf"; then
        _sed_i "s|^#? *${key}=.*|${key}=${value}|" "$conf"
    else
        echo "${key}=${value}" >> "$conf"
    fi
    echo "Set ${key}=${value} in $project_name"
}

_plugins_enable() {
    local conf="$1" plugin="$2"
    local current
    current=$(grep "^PLUGINS=" "$conf" | sed 's/^PLUGINS=//' | tr -d '"' || echo "")
    if [[ -z "$current" ]]; then
        if grep -q "^# PLUGINS=" "$conf"; then
            _sed_i "s|^# PLUGINS=.*|PLUGINS=$plugin|" "$conf"
        else
            echo "PLUGINS=$plugin" >> "$conf"
        fi
    else
        if echo "$current" | tr ',' '\n' | grep -qx "$plugin"; then
            return 0
        fi
        _sed_i "s|^PLUGINS=.*|PLUGINS=${current},$plugin|" "$conf"
    fi
}

_plugins_enable_with_deps() {
    local conf="$1" plugin="$2" seen="${3:-,}"
    local dep
    if [[ "$seen" == *",$plugin,"* ]]; then
        echo "Plugin dependency cycle involving '$plugin'" >&2
        return 1
    fi
    [[ -d "$CRAFT_ROOT/plugins/$plugin" ]] || {
        echo "Plugin not found: $CRAFT_ROOT/plugins/$plugin" >&2
        return 1
    }
    seen="${seen}${plugin},"
    while IFS= read -r dep; do
        [[ -n "$dep" ]] || continue
        _plugins_enable_with_deps "$conf" "$dep" "$seen" || return 1
    done < <(plugin_dependencies "$plugin")
    _plugins_enable "$conf" "$plugin"
}

cmd_plugin() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        --help|-h|"")
            cat << 'HELP'
craft plugin — Manage project plugins

Usage:
  craft plugin list                              Show available plugins
  craft plugin add <project> <plugin>            Enable a plugin for a project
  craft plugin check <project>                   Validate enabled plugins
  craft plugin set <plugin> <key> <value>        Set a plugin config value (shared across projects)
  craft plugin show <plugin>                     Show plugin config

Plugins are a shared library at $CRAFT_ROOT/plugins/. Enabling a plugin for a
project adds its name to PLUGINS= in that project's craft.conf and fires the
plugin's on_install hook. Plugins hook into task lifecycle events
(on_started, on_waiting, on_done, on_blocked, on_milestone, on_poll, on_install)
and run in subshells so failures don't break the orchestrator. Plugins without
hooks.sh are valid asset/config-only plugins.

Note: plugin.conf is optional. When present, it is shared across all projects
that enable the plugin.
There are no per-project plugin forks.

Available plugins:
  planning             Architect/discoverer commands and planning skills
  local-review         Pre-PR local review stage and event contracts
  bot-review           Automated local branch review
  diffhub              Diffhub local review UI and comment ingestion
  babysit-pr            GitHub PR watcher and review events
  buildkite-status     Buildkite status surface
  craft-dashboard      Web dashboard and cmux task badges
  slack-dm-notify      DMs you on Slack when a draft PR is ready
  slack-daily-thread   Posts PR events to a daily Slack channel thread
  linear-sync          Two-way sync with Linear issues

Example — set up Slack notifications:
  craft plugin add my-project slack-dm-notify
  craft plugin set slack-dm-notify SLACK_BOT_TOKEN xoxb-...
  craft plugin set slack-dm-notify SLACK_USER_ID U01ABC123
  craft plugin check my-project
HELP
            exit 0
            ;;

        list)
            echo "Available plugins (in $CRAFT_ROOT/plugins/):"
            for d in "$CRAFT_ROOT/plugins"/*/; do
                [[ -d "$d" ]] || continue
                local name
                name=$(basename "$d")
                local desc=""
                if [[ -f "$d/hooks.sh" ]]; then
                    desc=$(grep '^#' "$d/hooks.sh" | grep -v '^#!/' | head -1 | sed 's/^# *//')
                fi
                printf "  %-24s %s\n" "$name" "$desc"
            done
            ;;

        add)
            local project_name="${1:-}" plugin_name="${2:-}"
            if [[ -z "$project_name" || -z "$plugin_name" ]]; then
                echo "Usage: craft plugin add <project-name> <plugin-name>"
                exit 1
            fi
            local project_dir="$CRAFT_PROJECTS/$project_name"
            if [[ ! -d "$project_dir" ]]; then
                echo "Project not found: $project_dir"
                exit 1
            fi
            local plugin_dir="$CRAFT_ROOT/plugins/$plugin_name"
            if [[ ! -d "$plugin_dir" ]]; then
                echo "Plugin not found: $plugin_dir"
                echo "Run 'craft plugin list' to see available plugins."
                exit 1
            fi
            # Plugins are a shared library at $CRAFT_ROOT/plugins/. Enabling
            # the plugin = adding its name to PLUGINS= in this project's
            # craft.conf, firing on_install, then syncing any plugin-owned
            # project assets.
            _plugins_enable_with_deps "$project_dir/craft.conf" "$plugin_name"
            # Fire the plugin's on_install hook if defined.
            if [[ -f "$plugin_dir/hooks.sh" ]]; then
                (
                    PROJECT_DIR="$project_dir"
                    export PROJECT_DIR
                    # shellcheck source=/dev/null
                    source "$plugin_dir/hooks.sh"
                    if declare -f on_install > /dev/null 2>&1; then
                        on_install "$project_dir"
                    fi
                )
            fi
            if ! plugin_sync_project_assets "$project_dir"; then
                echo "Enabled $plugin_name in $project_name/craft.conf, but project asset sync failed." >&2
                echo "Resolve the conflict above and run: craft plugin check $project_name" >&2
                exit 1
            fi
            echo "Enabled $plugin_name in $project_name/craft.conf."
            local conf_keys
            conf_keys=$(grep '^[A-Z_]*=""' "$plugin_dir/plugin.conf" 2>/dev/null | sed 's/=.*//')
            if [[ -n "$conf_keys" ]]; then
                echo ""
                echo "Configure it with (note: shared across all projects):"
                while IFS= read -r key; do
                    echo "  craft plugin set $plugin_name $key <value>"
                done <<< "$conf_keys"
            fi
            ;;

        set)
            local plugin_name="${1:-}" key="${2:-}" value="${3:-}"
            if [[ -z "$plugin_name" || -z "$key" || -z "$value" ]]; then
                echo "Usage: craft plugin set <plugin-name> <key> <value>"
                echo "       (plugin config is shared across all projects)"
                exit 1
            fi
            local plugin_dir="$CRAFT_ROOT/plugins/$plugin_name"
            if [[ ! -d "$plugin_dir" ]]; then
                echo "Plugin not found: $plugin_dir"
                exit 1
            fi
            local conf="$plugin_dir/plugin.conf"
            [[ -f "$conf" ]] || : > "$conf"
            if grep -q "^${key}=" "$conf" || grep -q "^# ${key}=" "$conf"; then
                _sed_i "s|^#? *${key}=.*|${key}=\"${value}\"|" "$conf"
            else
                echo "${key}=\"${value}\"" >> "$conf"
            fi
            echo "Set ${key} in plugins/$plugin_name/plugin.conf."
            ;;

        show)
            local plugin_name="${1:-}"
            if [[ -z "$plugin_name" ]]; then
                echo "Usage: craft plugin show <plugin-name>"
                exit 1
            fi
            local conf="$CRAFT_ROOT/plugins/$plugin_name/plugin.conf"
            if [[ ! -d "$CRAFT_ROOT/plugins/$plugin_name" ]]; then
                echo "Plugin not found: $CRAFT_ROOT/plugins/$plugin_name"
                exit 1
            fi
            if [[ ! -f "$conf" ]]; then
                echo "Config for $plugin_name: no plugin.conf"
                exit 0
            fi
            echo "Config for $plugin_name ($conf):"
            grep -v '^#' "$conf" | grep -v '^[[:space:]]*$'
            ;;

        check)
            local project_name="${1:-}"
            if [[ -z "$project_name" ]]; then
                echo "Usage: craft plugin check <project-name>"
                exit 1
            fi
            local project_dir="$CRAFT_PROJECTS/$project_name"
            if [[ ! -d "$project_dir" ]]; then
                echo "Project not found: $project_dir"
                exit 1
            fi
            local conf="$project_dir/craft.conf"
            local plugins=""
            if [[ -f "$conf" ]]; then
                plugins=$(grep "^PLUGINS=" "$conf" | sed 's/^PLUGINS=//' | tr -d '"')
            fi
            if [[ -z "$plugins" ]]; then
                echo "No plugins enabled for $project_name."
                exit 0
            fi
            local all_ok=true
            IFS=',' read -ra plugin_list <<< "$plugins"
            for plugin in "${plugin_list[@]}"; do
                plugin="$(echo "$plugin" | xargs)"
                local plugin_dir="$CRAFT_ROOT/plugins/$plugin"
                local hooks_file="$CRAFT_ROOT/plugins/$plugin/hooks.sh"
                local missing_deps
                if [[ ! -d "$plugin_dir" ]]; then
                    echo "✗ $plugin — plugin directory not found"
                    all_ok=false
                    continue
                fi
                missing_deps="$(plugin_missing_dependencies "$project_dir" "$plugin" | paste -sd, -)"
                if [[ -n "$missing_deps" ]]; then
                    echo "✗ $plugin — missing DEPENDS_ON plugin(s): $missing_deps"
                    all_ok=false
                    continue
                fi
                if ! plugin_sync_project_assets "$project_dir" "$plugin"; then
                    echo "✗ $plugin — project asset sync failed"
                    all_ok=false
                    continue
                fi
                if [[ ! -f "$hooks_file" ]]; then
                    echo "✓ $plugin (no hooks)"
                    continue
                fi
                # Source and run check_deps in a subshell
                local result
                result=$(
                    source "$hooks_file" 2>/dev/null
                    if declare -f check_deps > /dev/null 2>&1; then
                        if check_deps 2>&1; then
                            echo "OK"
                        else
                            echo "FAIL"
                        fi
                    else
                        echo "OK_NO_CHECK"
                    fi
                ) 2>&1
                if [[ "$result" == "OK" ]]; then
                    echo "✓ $plugin"
                elif [[ "$result" == "OK_NO_CHECK" ]]; then
                    echo "✓ $plugin (no dep check defined)"
                else
                    echo "✗ $plugin"
                    # Re-run to show error output
                    (
                        source "$hooks_file" 2>/dev/null
                        check_deps 2>&1
                    ) || true
                    all_ok=false
                fi
            done
            echo ""
            if $all_ok; then
                echo "All plugins OK."
            else
                echo "Some plugins have issues. Fix them with 'craft plugin set'."
                exit 1
            fi
            ;;

        *)
            echo "Unknown plugin command: $subcmd"
            echo "Run 'craft plugin --help' for usage."
            exit 1
            ;;
    esac
}

cmd_doctor() {
    if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
        cat << 'HELP'
craft doctor — Check dependencies and environment

Usage:
  craft doctor [project-name]
  craft doctor --project-dir <path>

Verifies that all required tools are installed and reports their versions. When
a project is provided, or when run from inside a Craft project, also validates
the enabled plugins without mutating the project.

Required:  bash, git, tmux or cmux, gh, jq
Agents:    claude, codex (at least one needed)
Optional:  linear (for the linear-sync plugin), cmux (alternative to tmux)

Also checks that craft is on your PATH and shows environment info.
HELP
        exit 0
    fi

    local project_arg="" project_dir="" project_label=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project-dir)
                project_arg="${2:-}"
                [[ -n "$project_arg" ]] || { echo "craft doctor: --project-dir requires a value" >&2; exit 2; }
                shift 2
                ;;
            *)
                if [[ -z "$project_arg" ]]; then
                    project_arg="$1"
                    shift
                else
                    echo "craft doctor: unknown arg: $1" >&2
                    exit 2
                fi
                ;;
        esac
    done

    if [[ -n "$project_arg" ]]; then
        if [[ -f "$project_arg/craft.conf" ]]; then
            project_dir="$(cd "$project_arg" && pwd -P)"
        elif [[ -f "$CRAFT_PROJECTS/$project_arg/craft.conf" ]]; then
            project_dir="$(cd "$CRAFT_PROJECTS/$project_arg" && pwd -P)"
        else
            echo "craft doctor: project not found: $project_arg" >&2
            exit 2
        fi
    else
        project_dir="$(runtime_project_dir "$PWD" 2>/dev/null || true)"
    fi
    [[ -n "$project_dir" ]] && project_label="$(basename "$project_dir")"

    echo "craft doctor (v${CRAFT_VERSION})"
    echo ""

    local all_ok=true

    # Check required dependencies
    echo "Required:"
    for cmd in bash git gh jq; do
        if command -v "$cmd" > /dev/null 2>&1; then
            local ver
            case "$cmd" in
                bash)  ver="$("$cmd" --version 2>&1 | head -1 | sed 's/.*version //' | sed 's/(.*//')" ;;
                git)   ver="$(git --version | sed 's/git version //')" ;;
                gh)    ver="$(gh --version 2>&1 | head -1 | sed 's/.*version //' | sed 's/ .*//')" ;;
                jq)    ver="$(jq --version 2>&1 | sed 's/jq-//')" ;;
            esac
            printf "  %-12s ✓  %s\n" "$cmd" "$ver"
        else
            printf "  %-12s ✗  not found\n" "$cmd"
            all_ok=false
        fi
    done

    echo ""
    echo "Multiplexer (need at least one):"
    local has_mux=false
    if command -v tmux > /dev/null 2>&1; then
        printf "  %-12s ✓  %s\n" "tmux" "$(tmux -V 2>&1 | sed 's/tmux //')"
        has_mux=true
    else
        printf "  %-12s -  not found\n" "tmux"
    fi
    if command -v cmux > /dev/null 2>&1; then
        printf "  %-12s ✓  installed (macOS only)\n" "cmux"
        has_mux=true
    else
        printf "  %-12s -  not found\n" "cmux"
    fi
    if ! $has_mux; then
        all_ok=false
    fi

    echo ""
    echo "Agent providers:"
    for cmd in claude codex; do
        if command -v "$cmd" > /dev/null 2>&1; then
            local ver
            ver="$("$cmd" --version 2>&1 | head -1 || echo "installed")"
            printf "  %-12s ✓  %s\n" "$cmd" "$ver"
        else
            printf "  %-12s -  not found (optional)\n" "$cmd"
        fi
    done

    echo ""
    echo "Optional:"
    for cmd in linear; do
        if command -v "$cmd" > /dev/null 2>&1; then
            printf "  %-12s ✓  installed\n" "$cmd"
        else
            printf "  %-12s -  not found (needed for linear-sync plugin)\n" "$cmd"
        fi
    done

    echo ""
    echo "Environment:"
    printf "  %-12s %s\n" "CRAFT_ROOT" "$CRAFT_ROOT"
    printf "  %-12s %s\n" "shell" "$SHELL"
    printf "  %-12s %s\n" "platform" "$(uname -s) $(uname -m)"
    if [[ -n "$project_dir" ]]; then
        printf "  %-12s %s\n" "project" "$project_dir"
    fi

    if [[ -n "$project_dir" ]]; then
        echo ""
        echo "Plugin diagnostics ($project_label):"
        local plugin plugins_seen=false plugin_ok=true
        while IFS= read -r plugin; do
            [[ -n "$plugin" ]] || continue
            plugins_seen=true
            local plugin_dir="$CRAFT_ROOT/plugins/$plugin"
            local hooks_file="$plugin_dir/hooks.sh"
            local missing_deps output status
            if [[ ! -d "$plugin_dir" ]]; then
                printf "  %-24s ✗  plugin directory not found\n" "$plugin"
                plugin_ok=false
                continue
            fi
            missing_deps="$(plugin_missing_dependencies "$project_dir" "$plugin" | paste -sd, -)"
            if [[ -n "$missing_deps" ]]; then
                printf "  %-24s ✗  missing DEPENDS_ON plugin(s): %s\n" "$plugin" "$missing_deps"
                plugin_ok=false
                continue
            fi
            if [[ ! -f "$hooks_file" ]]; then
                printf "  %-24s ✓  no hooks\n" "$plugin"
                continue
            fi
            if output="$(
                PROJECT_DIR="$project_dir" CRAFT_ROOT="$CRAFT_ROOT" bash -c '
                    hooks_file="$1"
                    # shellcheck source=/dev/null
                    source "$hooks_file" 2>/dev/null || exit 2
                    if declare -f check_deps >/dev/null 2>&1; then
                        check_deps
                    else
                        exit 3
                    fi
                ' bash "$hooks_file" 2>&1
            )"; then
                printf "  %-24s ✓  check_deps passed\n" "$plugin"
            else
                status=$?
                if [[ "$status" -eq 3 ]]; then
                    printf "  %-24s ✓  no dep check defined\n" "$plugin"
                else
                    printf "  %-24s ✗  check_deps failed\n" "$plugin"
                    [[ -n "$output" ]] && printf '%s\n' "$output" | sed 's/^/    /'
                    plugin_ok=false
                fi
            fi
        done < <(plugin_enabled_plugins "$project_dir")
        if ! $plugins_seen; then
            echo "  none enabled"
        elif ! $plugin_ok; then
            all_ok=false
        fi
    fi

    # Check if craft is on PATH
    local craft_path
    craft_path="$(command -v craft 2>/dev/null || echo "")"
    if [[ -n "$craft_path" ]]; then
        printf "  %-12s ✓  %s\n" "craft" "$craft_path"
    else
        printf "  %-12s ✗  not on PATH (run: make install)\n" "craft"
        all_ok=false
    fi

    echo ""
    if $all_ok; then
        echo "All good. Run 'craft init <project-name>' to get started."
    else
        echo "Some checks failed. Fix them and re-run 'craft doctor'."
        exit 1
    fi
}

cmd_status() {
    if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
        cat << 'HELP'
craft status — Show project state at a glance

Usage:
  craft status <project-name>

Shows queue counts, waiting PRs, blocked tasks, and recent completions
without starting the orchestrator.
HELP
        exit 0
    fi

    local project_name="${1:-}"
    if [[ -z "$project_name" ]]; then
        echo "Usage: craft status <project-name>"
        echo "Run 'craft status --help' for details."
        exit 1
    fi

    local project_dir="$CRAFT_PROJECTS/$project_name"
    if [[ ! -d "$project_dir" ]]; then
        echo "Project not found: $project_dir"
        exit 1
    fi

    local queue_dir="$project_dir/queue"

    # Source queue helpers
    source "$CRAFT_ROOT/bin/lib/queue.sh"
    mapfile -t QUEUE_STATES < <(plugin_queue_states "$project_dir")

    echo "craft status: $project_name"
    echo ""
    local state label count
    local -A queue_counts=()
    for state in "${QUEUE_STATES[@]}"; do
        [[ "$state" == "archive" ]] && continue
        label=$(queue_state_label "$state")
        count=$(count_tasks "$queue_dir/$state" 2>/dev/null || echo 0)
        queue_counts["$state"]="$count"
        printf "  %-13s %s\n" "${label}:" "$count"
    done

    # Show waiting tasks with PR URLs
    local n_waiting="${queue_counts[waiting]:-0}"
    if [[ "$n_waiting" -gt 0 ]]; then
        echo ""
        echo "Waiting for review:"
        for task_file in $(list_tasks "$queue_dir/waiting"); do
            local tid pr_url title
            tid=$(task_id "$task_file")
            pr_url=$(task_field "$task_file" "pr")
            title=$(grep '^# ' "$task_file" | head -1 | sed 's/^# //')
            if [[ -n "$pr_url" ]]; then
                echo "  $tid  $pr_url"
            else
                echo "  $tid  ${title:-}"
            fi
        done
    fi

    # Show blocked tasks
    local n_blocked="${queue_counts[blocked]:-0}"
    if [[ "$n_blocked" -gt 0 ]]; then
        echo ""
        echo "Blocked:"
        for task_file in $(list_tasks "$queue_dir/blocked"); do
            local tid title
            tid=$(task_id "$task_file")
            title=$(grep '^# ' "$task_file" | head -1 | sed 's/^# //')
            echo "  $tid  ${title:-}"
        done
    fi
}

# Convert an ISO 8601 timestamp or YYYY-MM-DD date to epoch seconds
_to_epoch() {
    local ts="$1"
    [[ -z "$ts" ]] && return 1
    # macOS: try ISO 8601 then date-only (as UTC)
    if date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$ts" '+%s' 2>/dev/null; then return; fi
    if date -j -u -f '%Y-%m-%d' "$ts" '+%s' 2>/dev/null; then return; fi
    # GNU/Linux (append UTC if date-only to avoid timezone mismatch)
    if date -u -d "$ts" '+%s' 2>/dev/null; then return; fi
    return 1
}

# Format seconds into human-readable duration
_format_duration() {
    local s="$1"
    if (( s < 60 )); then echo "${s}s"
    elif (( s < 3600 )); then echo "$(( s / 60 ))m $(( s % 60 ))s"
    elif (( s < 86400 )); then echo "$(( s / 3600 ))h $(( (s % 3600) / 60 ))m"
    else echo "$(( s / 86400 ))d $(( (s % 86400) / 3600 ))h"
    fi
}

cmd_metrics() {
    if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
        cat << 'HELP'
craft metrics — Show task performance metrics

Usage:
  craft metrics <project-name>

Reports on completed task metrics including one-shot success rate
and average durations per phase.
HELP
        exit 0
    fi

    local project_name="${1:-}"
    if [[ -z "$project_name" ]]; then
        echo "Usage: craft metrics <project-name>"
        exit 1
    fi

    local project_dir="$CRAFT_PROJECTS/$project_name"
    if [[ ! -d "$project_dir" ]]; then
        echo "Project not found: $project_dir"
        exit 1
    fi

    local queue_dir="$project_dir/queue"
    source "$CRAFT_ROOT/bin/lib/queue.sh"

    # Queue snapshot
    local n_pending n_approved n_in_progress n_waiting n_done n_blocked
    n_pending=$(count_tasks "$queue_dir/pending" 2>/dev/null || echo 0)
    n_approved=$(count_tasks "$queue_dir/approved" 2>/dev/null || echo 0)
    n_in_progress=$(count_tasks "$queue_dir/in-progress" 2>/dev/null || echo 0)
    n_waiting=$(count_tasks "$queue_dir/waiting" 2>/dev/null || echo 0)
    n_done=$(count_tasks "$queue_dir/done" 2>/dev/null || echo 0)
    n_blocked=$(count_tasks "$queue_dir/blocked" 2>/dev/null || echo 0)

    # Collect completed tasks (done + archive)
    local task_files=()
    while IFS= read -r f; do
        [[ -f "$f" ]] && task_files+=("$f")
    done < <(list_tasks "$queue_dir/done" 2>/dev/null; find "$queue_dir/archive" -name '*.md' -not -name '.gitkeep' 2>/dev/null | sort)

    local total=0 one_shot_count=0
    local sum_to_started=0 n_to_started=0
    local sum_to_waiting=0 n_to_waiting=0
    local sum_to_done=0 n_to_done=0
    local sum_total=0 n_total=0

    for f in "${task_files[@]}"; do
        total=$((total + 1))

        local os
        os=$(task_field "$f" "one_shot")
        [[ "$os" == "true" ]] && one_shot_count=$((one_shot_count + 1))

        local t_created t_started t_waiting t_done
        t_created=$(task_field "$f" "created")
        t_started=$(task_field "$f" "started")
        t_waiting=$(task_field "$f" "waiting")
        t_done=$(task_field "$f" "done")

        local e_created e_started e_waiting e_done
        e_created=$(_to_epoch "$t_created" 2>/dev/null) || e_created=""
        e_started=$(_to_epoch "$t_started" 2>/dev/null) || e_started=""
        e_waiting=$(_to_epoch "$t_waiting" 2>/dev/null) || e_waiting=""
        e_done=$(_to_epoch "$t_done" 2>/dev/null) || e_done=""

        if [[ -n "$e_created" ]] && [[ -n "$e_started" ]]; then
            sum_to_started=$(( sum_to_started + e_started - e_created ))
            n_to_started=$(( n_to_started + 1 ))
        fi
        if [[ -n "$e_started" ]] && [[ -n "$e_waiting" ]]; then
            sum_to_waiting=$(( sum_to_waiting + e_waiting - e_started ))
            n_to_waiting=$(( n_to_waiting + 1 ))
        fi
        if [[ -n "$e_waiting" ]] && [[ -n "$e_done" ]]; then
            sum_to_done=$(( sum_to_done + e_done - e_waiting ))
            n_to_done=$(( n_to_done + 1 ))
        fi
        if [[ -n "$e_created" ]] && [[ -n "$e_done" ]]; then
            sum_total=$(( sum_total + e_done - e_created ))
            n_total=$(( n_total + 1 ))
        fi
    done

    # Output
    echo "craft metrics: $project_name"
    echo ""
    echo "Queue:"
    printf "  %-14s %s\n" "Pending:" "$n_pending"
    printf "  %-14s %s\n" "Approved:" "$n_approved"
    printf "  %-14s %s\n" "In Progress:" "$n_in_progress"
    printf "  %-14s %s\n" "Waiting:" "$n_waiting"
    printf "  %-14s %s\n" "Done:" "$n_done"
    printf "  %-14s %s\n" "Blocked:" "$n_blocked"
    echo ""

    if [[ $total -gt 0 ]]; then
        local pct=$(( one_shot_count * 100 / total ))
        echo "One-Shot Rate:   ${one_shot_count}/${total} (${pct}%)"
    else
        echo "One-Shot Rate:   — (no completed tasks)"
    fi
    echo ""

    echo "Average Durations:"
    if [[ $n_to_started -gt 0 ]]; then
        printf "  Created → Started:   %s (n=%d)\n" "$(_format_duration $(( sum_to_started / n_to_started )))" "$n_to_started"
    else
        echo "  Created → Started:   —"
    fi
    if [[ $n_to_waiting -gt 0 ]]; then
        printf "  Started → PR:        %s (n=%d)\n" "$(_format_duration $(( sum_to_waiting / n_to_waiting )))" "$n_to_waiting"
    else
        echo "  Started → PR:        —"
    fi
    if [[ $n_to_done -gt 0 ]]; then
        printf "  PR → Done:           %s (n=%d)\n" "$(_format_duration $(( sum_to_done / n_to_done )))" "$n_to_done"
    else
        echo "  PR → Done:           —"
    fi
    if [[ $n_total -gt 0 ]]; then
        printf "  Total (end-to-end):  %s (n=%d)\n" "$(_format_duration $(( sum_total / n_total )))" "$n_total"
    else
        echo "  Total (end-to-end):  —"
    fi
}

# --- Main dispatch ---

if [[ $# -eq 0 ]] || [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "help" ]]; then
    usage
    exit 0
fi

if [[ "${1:-}" == "--version" ]] || [[ "${1:-}" == "-v" ]] || [[ "${1:-}" == "version" ]]; then
    echo "craft ${CRAFT_VERSION}"
    exit 0
fi

SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
    init)
        if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
            cat << 'HELP'
craft init — Scaffold a new project

Usage:
  craft init <project-name>

Creates a new project in the projects directory with:
  - docs/plan.md          — project plan (edit this first)
  - queue/                — task queue directories
  - .claude/commands/     — Claude Code skills (slash commands)
  - craft.conf            — project configuration

Your operator name and GitHub username are auto-detected from git
config and the gh CLI. Override with environment variables:

  OPERATOR_NAME="Jane Doe" craft init my-project
  GITHUB_REVIEWER="jdoe" craft init my-project
  BRANCH_PREFIX="jd/" craft init my-project

After init:
  1. Edit docs/plan.md with your project goals
  2. Run 'craft my-project' to start the orchestrator
  3. Use /generate-milestone in the architect window to plan tasks
HELP
            exit 0
        fi
        exec "$CRAFT_ROOT/bin/init-project.sh" "$@"
        ;;
    config)
        cmd_config "$@"
        ;;
    plugin)
        cmd_plugin "$@"
        ;;
    task)
        cmd_task "$@"
        ;;
    workflow)
        cmd_workflow "$@"
        ;;
    event)
        cmd_event "$@"
        ;;
    surface)
        cmd_surface "$@"
        ;;
    doctor)
        cmd_doctor "$@"
        ;;
    projects|ls)
        if [[ ! -d "$CRAFT_PROJECTS" ]]; then
            echo "No projects directory: $CRAFT_PROJECTS"
            exit 1
        fi
        found=false
        for d in "$CRAFT_PROJECTS"/*/; do
            [[ -d "$d" ]] || continue
            found=true
            name=$(basename "$d")
            # Source queue helpers for counts
            source "$CRAFT_ROOT/bin/lib/queue.sh" 2>/dev/null
            queue_dir="$d/queue"
            n_in_progress=$(count_tasks "$queue_dir/in-progress" 2>/dev/null || echo 0)
            n_waiting=$(count_tasks "$queue_dir/waiting" 2>/dev/null || echo 0)
            n_done=$(count_tasks "$queue_dir/done" 2>/dev/null || echo 0)
            n_pending=$(count_tasks "$queue_dir/pending" 2>/dev/null || echo 0)
            n_approved=$(count_tasks "$queue_dir/approved" 2>/dev/null || echo 0)
            n_blocked=$(count_tasks "$queue_dir/blocked" 2>/dev/null || echo 0)
            total=$((n_pending + n_approved + n_in_progress + n_waiting + n_done + n_blocked))
            printf "  %-24s %d tasks (%d done, %d in-progress, %d waiting, %d blocked)\n" \
                "$name" "$total" "$n_done" "$n_in_progress" "$n_waiting" "$n_blocked"
        done
        if ! $found; then
            echo "No projects yet. Create one with: craft init <project-name>"
        fi
        ;;
    status)
        cmd_status "$@"
        ;;
    metrics)
        cmd_metrics "$@"
        ;;
    *)
        PROJECT_NAME="$SUBCOMMAND"
        PROJECT_DIR="$CRAFT_PROJECTS/$PROJECT_NAME"

        if [[ ! -d "$PROJECT_DIR" ]]; then
            echo "Project not found: $PROJECT_DIR"
            echo ""
            echo "Available projects:"
            ls "$CRAFT_PROJECTS/" 2>/dev/null || echo "  (none)"
            echo ""
            echo "Create one with: craft init $PROJECT_NAME"
            exit 1
        fi

        exec "$CRAFT_ROOT/bin/orchestrator.sh" "$PROJECT_DIR" "$@"
        ;;
esac
